<!-- FluentWindow = ventana de WPF-UI que dibuja su propia barra de título.
     WindowBackdropType="None": sin Mica ni acrílico (efectos que gastan GPU). -->
<ui:FluentWindow x:Class="OptimizadorPC.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:paginas="clr-namespace:OptimizadorPC.Paginas"
                 Title="Ghost Mode"
                 Width="1100" Height="700" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource FondoBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- barra de título -->
            <RowDefinition Height="*"/>      <!-- todo lo demás -->
        </Grid.RowDefinitions>

        <!-- Barra de título: rayo verde + nombre + botones minimizar/maximizar/cerrar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1">
            <ui:TitleBar Title="Ghost Mode">
                <ui:TitleBar.Icon>
                    <ui:SymbolIcon Symbol="Flash24" Foreground="{StaticResource ActivoBrush}"/>
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </Border>

        <!-- NavigationView = barra lateral + zona donde se muestra la página elegida.
             IsPaneToggleVisible="False": sin botón de hamburguesa, la barra siempre está abierta. -->
        <ui:NavigationView x:Name="Navegacion" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="230"
                           FrameMargin="0">

            <!-- Cabecera de la barra: logo + nombre + lema -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="14,20,14,24">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource ActivoSuaveBrush}">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="22" Foreground="{StaticResource ActivoBrush}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ghost Mode" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}"/>
                        <TextBlock Text="RENDIMIENTO BAJO CONTROL" FontSize="9"
                                   Foreground="{StaticResource TextoSecundarioBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- Pie de la barra: estado de los cambios, Deshacer todo y el hardware del equipo.
                 Los textos se rellenan desde MainWindow.xaml.cs con datos reales -->
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="14,0,14,16">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                        <ui:SymbolIcon x:Name="IconoCambios" Symbol="CheckmarkCircle20" FontSize="16"
                                       Foreground="{StaticResource ActivoBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtCambios" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextoSecundarioBrush}"/>
                    </StackPanel>

                    <!-- Appearance="Transparent" = botón sin fondo, como un enlace -->
                    <ui:Button x:Name="BtnDeshacerTodo" Content="Deshacer todo" Appearance="Transparent"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="4,6" Click="BtnDeshacerTodo_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUndo20"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- Línea separadora -->
                    <Border Height="1" Background="{StaticResource BordeBrush}" Margin="0,12"/>

                    <TextBlock x:Name="TxtEquipo" Text="EQUIPO LOCAL" FontSize="10"
                               Foreground="{StaticResource TextoTenueBrush}" Margin="4,0,0,6"/>
                    <TextBlock x:Name="TxtHardware" Text="Leyendo hardware…" FontSize="12"
                               TextWrapping="Wrap" Foreground="{StaticResource TextoSecundarioBrush}" Margin="4,0,0,0"/>
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <!-- Las secciones. TargetPageType = qué página abre al pulsarla -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Inicio" TargetPageType="{x:Type paginas:InicioPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Modo Gaming" TargetPageType="{x:Type paginas:ModoGamingPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Games24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- FiveM: no está en el diseño, va justo debajo de Modo Gaming -->
                <ui:NavigationViewItem Content="FiveM" TargetPageType="{x:Type paginas:FiveMPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="VehicleCar24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Optimizaciones" TargetPageType="{x:Type paginas:OptimizacionesPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Options24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Limpieza" TargetPageType="{x:Type paginas:LimpiezaPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Broom24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Inicio de Windows" TargetPageType="{x:Type paginas:InicioWindowsPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Power24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Red" TargetPageType="{x:Type paginas:RedPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Wifi124"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Monitor" TargetPageType="{x:Type paginas:MonitorPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Pulse24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Ajustes" TargetPageType="{x:Type paginas:AjustesPagina}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
