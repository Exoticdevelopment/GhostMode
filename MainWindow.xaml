<Window x:Class="OptimizadorPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimizadorPC - Prueba" Height="350" Width="500"
        Background="#0F1115">

    <StackPanel Margin="24">
        <TextBlock Text="OptimizadorPC" FontSize="24" FontWeight="SemiBold"
                   Foreground="White" Margin="0,0,0,16"/>

        <TextBlock x:Name="TxtNombre" Foreground="White" FontSize="16"/>
        <TextBlock x:Name="TxtDescripcion" Foreground="#9CA3AF" Margin="0,4,0,16"/>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnAplicar" Content="Aplicar" Width="120" Height="36"
                    Margin="0,0,10,0" Click="BtnAplicar_Click"/>
            <Button x:Name="BtnRevertir" Content="Revertir" Width="120" Height="36"
                    Click="BtnRevertir_Click"/>
        </StackPanel>

        <TextBlock x:Name="TxtEstado" FontSize="16" Margin="0,20,0,0"/>
    </StackPanel>
</Window>