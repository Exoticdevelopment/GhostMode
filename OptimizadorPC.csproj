<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Incrusta app.manifest en el .exe (pide permisos de administrador) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Metadatos del .exe: se ven en Propiedades > Detalles de Windows -->
    <Product>Ghost Mode</Product>
    <Authors>Exoticdevelopment</Authors>
    <Company>Exoticdevelopment</Company>
    <Copyright>© 2026 Miguel Ángel González Zuluaga — github.com/Exoticdevelopment</Copyright>

    <!-- Ícono del .exe (Explorador, barra de tareas, Alt+Tab) -->
    <ApplicationIcon>Assets\ghostmode.ico</ApplicationIcon>

    <!-- Solo afectan a "dotnet publish" con PublishSingleFile=true: -->
    <!-- mete también las DLL nativas de WPF dentro del .exe (si no, quedan sueltas al lado) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- comprime el contenido: .exe mucho más pequeño, arranca un poco más lento -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Resource = el archivo va DENTRO del programa y el XAML lo encuentra con
       "pack://application:,,,/Assets/ghostmode.ico" (barra de título y logo de la barra lateral) -->
  <ItemGroup>
    <Resource Include="Assets\ghostmode.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
