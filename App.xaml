<Application x:Class="OptimizadorPC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- xmlns:ui = "prefijo" para usar los controles de WPF-UI: <ui:FluentWindow>, <ui:SymbolIcon>... -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Colores del tema oscuro de WPF-UI -->
                <ui:ThemesDictionary Theme="Dark"/>
                <!-- 2. El aspecto de todos los controles de WPF-UI -->
                <ui:ControlsDictionary/>
                <!-- 3. Nuestra paleta. Va al final para que sus colores ganen a los de WPF-UI -->
                <ResourceDictionary Source="Estilos/Colores.xaml"/>
                <!-- 4. Estilos compartidos: tarjetas, pastillas, botones, interruptor... -->
                <ResourceDictionary Source="Estilos/Controles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
