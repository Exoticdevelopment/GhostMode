<!-- Bienvenida de 3 pasos (solo la primera vez; se puede volver a ver desde Ajustes):
       1. qué hace Ghost Mode   2. todo es reversible   3. diagnóstico rápido del equipo con recomendaciones -->
<ui:FluentWindow x:Class="OptimizadorPC.Paginas.BienvenidaVentana"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Bienvenida · Ghost Mode"
                 Width="620" Height="560" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="DoNotRound"
                 Background="{StaticResource FondoBrush}">

    <Border BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TitleBar Title="ghost_mode · bienvenida" FontFamily="{StaticResource FuenteMono}" FontSize="12"
                         ShowMaximize="False" ShowMinimize="False"/>

            <!-- Los tres pasos: solo uno visible a la vez -->
            <Grid Grid.Row="1" Margin="36,12,36,0">

                <!-- Paso 1 -->
                <StackPanel x:Name="Paso1">
                    <TextBlock Text="&gt; hola" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock Style="{StaticResource SubtituloPaginaEstilo}" FontSize="14" Margin="0,14,0,0"
                               Text="Ghost Mode prepara Windows para jugar en equipos modestos, sin trucos raros:"/>
                    <TextBlock Style="{StaticResource DatoEstilo}" Margin="0,18,0,0" LineHeight="26" TextWrapping="Wrap">
                        <Run Text="+ un clic aplica las optimizaciones seguras (plan de energía, Modo Juego, efectos)"/><LineBreak/>
                        <Run Text="+ modo_gaming se activa solo al abrir tu juego y se deshace al cerrarlo"/><LineBreak/>
                        <Run Text="+ limpieza, programas de inicio, red y monitor en vivo"/><LineBreak/>
                        <Run Text="+ benchmark para medir los FPS antes y después, con datos reales"/>
                    </TextBlock>
                </StackPanel>

                <!-- Paso 2 -->
                <StackPanel x:Name="Paso2" Visibility="Collapsed">
                    <TextBlock Text="&gt; todo_es_reversible" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock Style="{StaticResource SubtituloPaginaEstilo}" FontSize="14" Margin="0,14,0,0"
                               Text="Antes de cambiar algo, Ghost Mode guarda cómo estaba. Siempre puedes volver atrás:"/>
                    <TextBlock Style="{StaticResource DatoEstilo}" Margin="0,18,0,0" LineHeight="26" TextWrapping="Wrap">
                        <Run Text="+ se crea un punto de restauración de Windows antes del primer cambio"/><LineBreak/>
                        <Run Text="+ cada ajuste se puede revertir uno a uno"/><LineBreak/>
                        <Run Text="+ [ deshacer_todo ] (abajo a la izquierda) lo devuelve todo de una vez"/><LineBreak/>
                        <Run Text="+ nunca desactiva Windows Defender ni Windows Update"/>
                    </TextBlock>
                </StackPanel>

                <!-- Paso 3: diagnóstico -->
                <StackPanel x:Name="Paso3" Visibility="Collapsed">
                    <TextBlock Text="&gt; diagnóstico_rápido" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock x:Name="TxtLeyendo" Text="leyendo el equipo..." Style="{StaticResource SubtituloPaginaEstilo}"
                               FontSize="14" Margin="0,14,0,0"/>

                    <Grid x:Name="TablaEquipo" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ram" Style="{StaticResource EtiquetaEstilo}" Margin="0,4"/>
                        <TextBlock x:Name="TxtRam" Grid.Column="1" Style="{StaticResource DatoEstilo}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="gráfica" Style="{StaticResource EtiquetaEstilo}" Margin="0,4"/>
                        <TextBlock x:Name="TxtGpu" Grid.Row="1" Grid.Column="1" Style="{StaticResource DatoEstilo}" Margin="0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="disco" Style="{StaticResource EtiquetaEstilo}" Margin="0,4"/>
                        <TextBlock x:Name="TxtDisco" Grid.Row="2" Grid.Column="1" Style="{StaticResource DatoEstilo}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="espacio libre" Style="{StaticResource EtiquetaEstilo}" Margin="0,4"/>
                        <TextBlock x:Name="TxtEspacio" Grid.Row="3" Grid.Column="1" Style="{StaticResource DatoEstilo}" Margin="0,4"/>
                    </Grid>

                    <!-- Una línea por recomendación, con su color -->
                    <ItemsControl x:Name="ListaConsejos" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="6" Height="6" Margin="0,6,10,0" VerticalAlignment="Top" Fill="{Binding Color}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource ExplicacionEstilo}"
                                               Foreground="{StaticResource TextoBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Pie: puntos de progreso y botones -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="36,16">
                <Grid>
                    <TextBlock x:Name="TxtPaso" Text="1 / 3" Style="{StaticResource EtiquetaEstilo}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="BtnAtras" Content="[ atrás ]" Style="{StaticResource BotonSecundarioEstilo}"
                                   Visibility="Hidden" Click="BtnAtras_Click"/>
                        <ui:Button x:Name="BtnSiguiente" Content="[ siguiente ]" Margin="10,0,0,0"
                                   Style="{StaticResource BotonPrincipalEstilo}" Click="BtnSiguiente_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
