<!-- Página Inicio: uso de recursos en vivo, el botón grande "Activar Ghost Mode",
     y abajo Puntuación y Perfil (llegan más adelante) -->
<Page x:Class="OptimizadorPC.Paginas.InicioPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Inicio">

    <Page.Resources>
        <!-- El botón redondo grande. Su plantilla dibuja dos anillos y pone el contenido en el centro -->
        <Style x:Key="BotonRedondoEstilo" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Anillo exterior, gris y fino -->
                            <Ellipse Stroke="{StaticResource BordeBrush}" StrokeThickness="1"/>
                            <!-- Anillo interior verde con relleno verde translúcido -->
                            <Ellipse x:Name="Anillo" Margin="14" StrokeThickness="3"
                                     Stroke="{StaticResource ActivoBrush}" Fill="{StaticResource ActivoSuaveBrush}"/>
                            <!-- ContentPresenter = "aquí va lo que pongas dentro del botón" -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Anillo" Property="StrokeThickness" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Anillo" Property="Margin" Value="18"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Anillo" Property="StrokeThickness" Value="5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Anillo" Property="Stroke" Value="{StaticResource AvisoBrush}"/>
                                <Setter TargetName="Anillo" Property="Fill" Value="{StaticResource AvisoSuaveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastilla de perfil, desactivada hasta que exista la función -->
        <Style x:Key="PerfilEstilo" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,36,44,36">
            <TextBlock Text="Tu PC, listo para jugar" Style="{StaticResource TituloPaginaEstilo}"/>
            <TextBlock Text="Menos procesos. Más recursos para lo que importa." Style="{StaticResource SubtituloPaginaEstilo}"/>

            <!-- ===== Los 4 medidores. Los valores se rellenan desde el código cada 2 segundos ===== -->
            <UniformGrid Rows="1" Margin="0,24,-16,0">
                <componentes:MedidorRecurso x:Name="MedCpu" Etiqueta="CPU" Icono="DeveloperBoard24" Margin="0,0,16,0"/>
                <componentes:MedidorRecurso x:Name="MedRam" Etiqueta="RAM" Icono="Ram20" Margin="0,0,16,0"/>
                <componentes:MedidorRecurso x:Name="MedGpu" Etiqueta="GPU" Icono="Video24" Margin="0,0,16,0"/>
                <componentes:MedidorRecurso x:Name="MedTemp" Etiqueta="TEMPERATURA" Icono="Temperature24" Margin="0,0,16,0"
                                            Valor="No disponible" Detalle="Windows no la informa sin programas extra"/>
            </UniformGrid>

            <!-- ===== Bloque central: Ghost Mode ===== -->
            <Border Style="{StaticResource TarjetaEstilo}" Margin="0,20,0,0" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: estado y lema -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PuntoEstado" Width="8" Height="8" Fill="{StaticResource TextoTenueBrush}"/>
                            <TextBlock x:Name="TxtEstado" Text="GHOST MODE · …" FontSize="13" FontWeight="SemiBold"
                                       Margin="10,0,0,0" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Dale prioridad a tu partida." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Foreground="{StaticResource TextoBrush}"/>
                        <TextBlock Text="Libera recursos y reduce tareas en segundo plano con un clic." FontSize="14"
                                   TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource TextoSecundarioBrush}"/>
                    </StackPanel>

                    <!-- Centro: el botón grande -->
                    <Button x:Name="BtnGhost" Grid.Column="1" Style="{StaticResource BotonRedondoEstilo}"
                            IsEnabled="False" Click="BtnGhost_Click">
                        <StackPanel HorizontalAlignment="Center" Width="150">
                            <ui:SymbolIcon Symbol="Power28" FontSize="40" HorizontalAlignment="Center"
                                           Foreground="{StaticResource ActivoBrush}"/>
                            <TextBlock x:Name="TxtBotonGhost" Text="LEYENDO ESTADO…" FontSize="16" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Foreground="{StaticResource ActivoBrush}"/>
                            <TextBlock x:Name="TxtBotonGhostDetalle" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Derecha: qué pasa al activar (todo dato real) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="AL ACTIVAR" Style="{StaticResource EtiquetaEstilo}" FontSize="13" FontWeight="SemiBold"/>
                        <!-- Cada fila es un Grid: columna 1 el icono, columna 2 el texto.
                             En un StackPanel horizontal el texto no puede saltar de línea (tiene ancho infinito);
                             en la columna "*" del Grid sí, porque su ancho es el que sobra -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Flash20" FontSize="18" Foreground="{StaticResource ActivoBrush}"
                                           VerticalAlignment="Top"/>
                            <TextBlock x:Name="TxtCuantasSeguras" Grid.Column="1" FontSize="14" Margin="10,0,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextoBrush}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="18" Foreground="{StaticResource ActivoBrush}"
                                           VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Punto de restauración antes" FontSize="14" Margin="10,0,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextoBrush}"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowUndo20" FontSize="18" Foreground="{StaticResource ActivoBrush}"
                                           VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Cambios reversibles" FontSize="14" Margin="10,0,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextoBrush}"/>
                        </Grid>
                        <TextBlock Text="Se pedirá confirmación antes de aplicar los cambios." FontSize="12" TextWrapping="Wrap"
                                   Margin="0,16,0,0" Foreground="{StaticResource TextoTenueBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Fila de abajo: Puntuación y Perfil ===== -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Puntuación: sin benchmark no hay número que mostrar (nada inventado) -->
                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel>
                        <TextBlock Text="Puntuación de rendimiento" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="32" Foreground="{StaticResource TextoTenueBrush}"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ejecuta un benchmark para medir tu equipo" FontSize="14"
                                           Foreground="{StaticResource TextoSecundarioBrush}"/>
                                <TextBlock Text="Próximamente: comparará el antes y el después de optimizar." FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextoTenueBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Perfil: los tres botones existen en el diseño pero aún no hacen nada -->
                <Border Grid.Column="2" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Perfil de rendimiento" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextoBrush}"/>
                            <Border Style="{StaticResource PastillaEstilo}" HorizontalAlignment="Right" Margin="0">
                                <TextBlock Text="Próximamente" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PerfilEstilo}">
                                <TextBlock Text="Gaming extremo" FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"/>
                            </Border>
                            <Border Style="{StaticResource PerfilEstilo}">
                                <TextBlock Text="Equilibrado" FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"/>
                            </Border>
                            <Border Style="{StaticResource PerfilEstilo}">
                                <TextBlock Text="Batería" FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Podrás elegir entre fluidez, consumo y temperatura." FontSize="13" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Foreground="{StaticResource TextoTenueBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
