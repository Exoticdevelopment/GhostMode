<!-- Página Inicio. Por ahora solo el encabezado; el contenido llega en el paso 6 -->
<Page x:Class="OptimizadorPC.Paginas.InicioPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inicio">

    <StackPanel Margin="44,36,44,36">
        <TextBlock Text="Tu PC, listo para jugar" FontSize="30" FontWeight="SemiBold"
                   Foreground="{StaticResource TextoBrush}"/>
        <TextBlock Text="Menos procesos. Más recursos para lo que importa." FontSize="14" Margin="0,6,0,0"
                   Foreground="{StaticResource TextoSecundarioBrush}"/>
    </StackPanel>
</Page>
