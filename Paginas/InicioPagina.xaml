<!-- Página Inicio, estilo terminal. De arriba abajo, por importancia:
       0. banner ASCII "GHOST mode": gris con Ghost Mode apagado, morado encendido
       1. panel "ghost_mode" con el botón grande (la acción principal de la app)
       2. panel "recursos": CPU, RAM, GPU y temperatura de la GPU en vivo, y el disco C: libre
       3. panel "log" con lo último que hizo la app
       4. panel "puntuación" con el último benchmark real -->
<Page x:Class="OptimizadorPC.Paginas.InicioPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Inicio">

    <Page.Resources>
        <!-- El botón grande de Ghost Mode. Regla de contraste: texto morado SOLO sobre negro;
             sobre morado, texto negro.
               normal:          fondo negro, borde morado 2 px, texto morado claro
               ratón encima:    fondo morado, texto negro
               Tag="on" (ON):   fondo morado, texto negro (lo pone InicioPagina.xaml.cs)
             Los colores se ponen en el propio botón y el texto de dentro los toma con
             Foreground="{Binding Foreground, ...}", así ningún estilo heredado los pisa -->
        <Style x:Key="BotonGhostEstilo" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource FondoBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AcentoBrilloBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="2" BorderThickness="2"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- En los Trigger, el último que se cumple gana: el orden importa -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AcentoBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FondoBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="{StaticResource AcentoBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FondoBrush}"/>
                </Trigger>
                <!-- Foco con teclado (Tab): borde claro para saber dónde estamos -->
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TextoBrush}"/>
                </Trigger>
                <!-- Leyendo o aplicando: negro con borde y texto ámbar -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource FondoBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AvisoBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AvisoBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Línea de la lista "al activar:" -->
        <Style x:Key="LineaListaEstilo" TargetType="TextBlock" BasedOn="{StaticResource DatoEstilo}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Separación entre medidores: una línea vertical a la izquierda (menos el primero) -->
        <Style x:Key="ColumnaMedidorEstilo" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="16,0,12,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">
            <componentes:PromptTerminal Comando="status"/>
            <TextBlock Text="Uso de recursos en vivo y acceso directo a Ghost Mode." Style="{StaticResource SubtituloPaginaEstilo}"/>

            <!-- ===== 0. Banner: el estado de Ghost Mode se ve de lejos, por el color ===== -->
            <componentes:BannerGhost x:Name="Banner" Margin="0,18,0,0"/>

            <!-- ===== 1. Ghost Mode: lo primero que se ve, porque es para lo que existe la app ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="ghost_mode" Margin="0,16,0,0"
                                    Padding="20,22,20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: estado, explicación y el botón -->
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Cuadradito de estado: morado = ON (el color de Ghost Mode), gris = OFF -->
                            <Rectangle x:Name="PuntoEstado" Width="8" Height="8" VerticalAlignment="Center"
                                       Fill="{StaticResource TextoSecundarioBrush}"/>
                            <TextBlock x:Name="TxtEstado" Text="&gt; ghost_mode: ..." Margin="10,0,0,0"
                                       Style="{StaticResource DatoEstilo}" FontSize="{StaticResource TamanoDato}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,8,0,16"
                                   Text="Aplica de una vez las optimizaciones de riesgo bajo. Todas se pueden deshacer."/>

                        <!-- El brillo morado: el ÚNICO efecto de la app (un DropShadowEffect pequeño y sin desplazamiento).
                             Solo aquí, porque es la acción principal -->
                        <Button x:Name="BtnGhost" Style="{StaticResource BotonGhostEstilo}" Tag="off"
                                IsEnabled="False" Click="BtnGhost_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="{StaticResource AcentoColor}" ShadowDepth="0" BlurRadius="14" Opacity="0.6"/>
                            </Button.Effect>
                            <TextBlock x:Name="TxtBotonGhost" Text="[ LEYENDO ESTADO... ]" FontFamily="{StaticResource FuenteMono}"
                                       FontSize="{StaticResource TamanoDato}" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock x:Name="TxtBotonGhostDetalle" Style="{StaticResource EtiquetaEstilo}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Derecha: qué pasa al activar (todo dato real), separado por una línea vertical -->
                    <Border Grid.Column="1" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1,0,0,0"
                            Padding="20,0,0,0" Width="250">
                        <StackPanel>
                            <TextBlock Text="al activar:" Style="{StaticResource EtiquetaEstilo}"/>
                            <TextBlock x:Name="TxtCuantasSeguras" Style="{StaticResource LineaListaEstilo}" Margin="0,10,0,0"/>
                            <TextBlock Text="+ punto de restauración previo" Style="{StaticResource LineaListaEstilo}"/>
                            <TextBlock Text="+ cambios reversibles" Style="{StaticResource LineaListaEstilo}"/>
                            <TextBlock Text="* se pide confirmación antes de aplicar" Style="{StaticResource EtiquetaEstilo}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </HeaderedContentControl>

            <!-- ===== 2. Recursos: los 4 medidores en UNA franja (como la cabecera de htop), no 4 tarjetas.
                 Los valores se rellenan desde el código cada 2 segundos ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="recursos" Tag="cada 2 s" Margin="0,16,0,0"
                                    Padding="4,22,8,14">
                <StackPanel>
                    <UniformGrid Rows="1">
                        <!-- El primero sin línea a la izquierda: ya está el borde del panel -->
                        <Border Style="{StaticResource ColumnaMedidorEstilo}" BorderThickness="0">
                            <componentes:MedidorRecurso x:Name="MedCpu" Etiqueta="cpu"/>
                        </Border>
                        <Border Style="{StaticResource ColumnaMedidorEstilo}">
                            <componentes:MedidorRecurso x:Name="MedRam" Etiqueta="ram"/>
                        </Border>
                        <Border Style="{StaticResource ColumnaMedidorEstilo}">
                            <componentes:MedidorRecurso x:Name="MedGpu" Etiqueta="gpu"/>
                        </Border>
                        <!-- Temperatura de la GPU con NVML (solo NVIDIA). Sin dato: "N/D" y el motivo -->
                        <Border Style="{StaticResource ColumnaMedidorEstilo}">
                            <componentes:MedidorRecurso x:Name="MedTemp" Etiqueta="temp gpu" Valor="N/D"/>
                        </Border>
                    </UniformGrid>

                    <!-- Línea secundaria de la franja: el espacio libre del disco C: (se lee con cada muestra) -->
                    <Border BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Margin="16,12,8,0" Padding="0,10,0,0">
                        <TextBlock x:Name="TxtDiscoC" Text="disco c:  leyendo..." Style="{StaticResource EtiquetaEstilo}"/>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== 3. Log en vivo ===== -->
            <componentes:PanelLog Margin="0,16,0,0"/>

            <!-- ===== 4. Puntuación: el último benchmark real. Sin benchmark no hay número que mostrar (nada inventado).
                 El Tag ("último benchmark", arriba a la derecha) lo pone el código solo si hay uno ===== -->
            <HeaderedContentControl x:Name="PanelPuntuacion" Style="{StaticResource PanelEstilo}" Header="puntuación"
                                    Margin="0,16,0,0">
                <StackPanel>
                    <!-- Con benchmark: % de mejora grande y barras Antes / Después en FPS -->
                    <Grid x:Name="PanelConBenchmark" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <!-- El número más importante de la pantalla cuando existe: tamaño héroe -->
                            <TextBlock x:Name="TxtMejora" Style="{StaticResource DatoEstilo}" FontSize="{StaticResource TamanoHeroe}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="fps promedio" Style="{StaticResource EtiquetaEstilo}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="antes" Style="{StaticResource EtiquetaEstilo}" Margin="0,5,10,5"/>
                            <ProgressBar x:Name="BarraAntes" Grid.Column="1" Style="{StaticResource BarraRecursoEstilo}"
                                         Foreground="{StaticResource TextoSecundarioBrush}"/>
                            <TextBlock x:Name="TxtAntes" Grid.Column="2" Style="{StaticResource EtiquetaEstilo}" Margin="10,5,0,5"/>
                            <!-- Después = con Ghost Mode: en morado, el color de Ghost Mode -->
                            <TextBlock Grid.Row="1" Text="después" Style="{StaticResource EtiquetaEstilo}" Margin="0,5,10,5"/>
                            <ProgressBar x:Name="BarraDespues" Grid.Row="1" Grid.Column="1" Style="{StaticResource BarraRecursoEstilo}"
                                         Foreground="{StaticResource AcentoBrush}"/>
                            <TextBlock x:Name="TxtDespues" Grid.Row="1" Grid.Column="2" Style="{StaticResource EtiquetaEstilo}"
                                       Foreground="{StaticResource AcentoBrilloBrush}" Margin="10,5,0,5"/>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="TxtBenchmarkDetalle" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>

                    <!-- Sin benchmark: decir qué hacer, no solo que falta -->
                    <StackPanel x:Name="PanelSinBenchmark">
                        <TextBlock Text="&gt; sin_datos" Style="{StaticResource DatoEstilo}"/>
                        <TextBlock Text="Mide los FPS de tu juego en la sección benchmark para ver aquí cuánto mejora con Ghost Mode."
                                   Style="{StaticResource ExplicacionEstilo}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
