<!-- Página Inicio, estilo terminal: uso de recursos en vivo, el botón "[ ACTIVAR GHOST MODE ]",
     el panel [ LOG ] y abajo Puntuación (último benchmark) y Perfil (llega más adelante) -->
<Page x:Class="OptimizadorPC.Paginas.InicioPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Inicio">

    <Page.Resources>
        <!-- El botón grande de Ghost Mode: rectángulo con borde morado.
             Tag="on" (lo pone InicioPagina.xaml.cs) = relleno morado con texto negro -->
        <Style x:Key="BotonGhostEstilo" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caja" CornerRadius="2" BorderThickness="1"
                                BorderBrush="{StaticResource AcentoBrush}" Background="Transparent">
                            <!-- TextElement.Foreground = color del texto de dentro (se cambia en los Trigger) -->
                            <ContentPresenter x:Name="Contenido" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource AcentoBrilloBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Apagado + ratón encima: fondo morado oscuro -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Background" Value="{StaticResource AcentoFondoBrush}"/>
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource AcentoBrilloBrush}"/>
                            </Trigger>
                            <!-- Encendido: relleno morado, texto negro -->
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Caja" Property="Background" Value="{StaticResource AcentoBrush}"/>
                                <Setter TargetName="Contenido" Property="TextElement.Foreground" Value="{StaticResource FondoBrush}"/>
                            </Trigger>
                            <!-- Encendido + ratón encima: morado brillante -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="on"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Caja" Property="Background" Value="{StaticResource AcentoBrilloBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource TextoBrush}"/>
                            </Trigger>
                            <!-- Leyendo o aplicando: borde y texto ámbar -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caja" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{StaticResource AvisoBrush}"/>
                                <Setter TargetName="Contenido" Property="TextElement.Foreground" Value="{StaticResource AvisoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Línea de la lista "[ AL ACTIVAR ]" -->
        <Style x:Key="LineaListaEstilo" TargetType="TextBlock" BasedOn="{StaticResource DatoEstilo}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Pastilla de perfil, desactivada hasta que exista la función -->
        <Style x:Key="PerfilEstilo" TargetType="Border" BasedOn="{StaticResource PastillaEstilo}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">
            <TextBlock Text="&gt; sistema_listo" Style="{StaticResource TituloPaginaEstilo}"/>
            <TextBlock Text="Uso de recursos en vivo y acceso directo a Ghost Mode." Style="{StaticResource SubtituloPaginaEstilo}"/>

            <!-- ===== Los 4 medidores. Los valores se rellenan desde el código cada 2 segundos ===== -->
            <UniformGrid Rows="1" Margin="0,20,-12,0">
                <componentes:MedidorRecurso x:Name="MedCpu" Etiqueta="[ CPU ]" Margin="0,0,12,0"/>
                <componentes:MedidorRecurso x:Name="MedRam" Etiqueta="[ RAM ]" Margin="0,0,12,0"/>
                <componentes:MedidorRecurso x:Name="MedGpu" Etiqueta="[ GPU ]" Margin="0,0,12,0"/>
                <componentes:MedidorRecurso x:Name="MedTemp" Etiqueta="[ TEMP ]" Margin="0,0,12,0"
                                            Valor="N/D" Detalle="Windows no expone el sensor sin drivers extra"/>
            </UniformGrid>

            <!-- ===== Bloque Ghost Mode ===== -->
            <Border Style="{StaticResource TarjetaEstilo}" Margin="0,12,0,0" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: estado, explicación y el botón -->
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="SYS.STATUS" Style="{StaticResource EtiquetaEstilo}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- Cuadradito de estado: verde = ON, gris = OFF -->
                            <Rectangle x:Name="PuntoEstado" Width="8" Height="8" VerticalAlignment="Center"
                                       Fill="{StaticResource TextoSecundarioBrush}"/>
                            <TextBlock x:Name="TxtEstado" Text="&gt; GHOST_MODE: ..." Margin="10,0,0,0"
                                       Style="{StaticResource DatoEstilo}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,10,0,16"
                                   Text="Aplica de una vez las optimizaciones de riesgo bajo. Todas se pueden deshacer."/>

                        <Button x:Name="BtnGhost" Style="{StaticResource BotonGhostEstilo}" Tag="off"
                                IsEnabled="False" Click="BtnGhost_Click">
                            <TextBlock x:Name="TxtBotonGhost" Text="[ LEYENDO ESTADO... ]" FontFamily="{StaticResource FuenteMono}"
                                       FontSize="15" FontWeight="Bold"/>
                        </Button>
                        <TextBlock x:Name="TxtBotonGhostDetalle" Style="{StaticResource EtiquetaEstilo}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Derecha: qué pasa al activar (todo dato real), separado por una línea vertical -->
                    <Border Grid.Column="1" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1,0,0,0"
                            Padding="20,0,0,0" Width="250">
                        <StackPanel>
                            <TextBlock Text="[ AL ACTIVAR ]" Style="{StaticResource EtiquetaEstilo}"/>
                            <TextBlock x:Name="TxtCuantasSeguras" Style="{StaticResource LineaListaEstilo}" Margin="0,12,0,0"/>
                            <TextBlock Text="+ punto de restauración previo" Style="{StaticResource LineaListaEstilo}"/>
                            <TextBlock Text="+ cambios reversibles" Style="{StaticResource LineaListaEstilo}"/>
                            <TextBlock Text="* se pide confirmación antes de aplicar" Style="{StaticResource EtiquetaEstilo}"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Log en vivo ===== -->
            <componentes:PanelLog Margin="0,12,0,0"/>

            <!-- ===== Fila de abajo: Puntuación y Perfil ===== -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Puntuación: el último benchmark real. Sin benchmark no hay número que mostrar (nada inventado) -->
                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="[ PUNTUACIÓN ]" Style="{StaticResource EtiquetaEstilo}"/>
                            <Border x:Name="PastillaBenchmark" Style="{StaticResource PastillaEstilo}" HorizontalAlignment="Right"
                                    Margin="0" Visibility="Collapsed">
                                <TextBlock Text="último benchmark" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                        </Grid>

                        <!-- Con benchmark: % de mejora grande y barras Antes / Después en FPS -->
                        <Grid x:Name="PanelConBenchmark" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="TxtMejora" Style="{StaticResource DatoEstilo}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="fps promedio" Style="{StaticResource EtiquetaEstilo}"/>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="antes  " Style="{StaticResource EtiquetaEstilo}" Margin="0,5,8,5"/>
                                <ProgressBar x:Name="BarraAntes" Grid.Column="1" Style="{StaticResource BarraRecursoEstilo}"
                                             Foreground="{StaticResource TextoSecundarioBrush}"/>
                                <TextBlock x:Name="TxtAntes" Grid.Column="2" Style="{StaticResource EtiquetaEstilo}" Margin="10,5,0,5"/>
                                <TextBlock Grid.Row="1" Text="después" Style="{StaticResource EtiquetaEstilo}" Margin="0,5,8,5"/>
                                <ProgressBar x:Name="BarraDespues" Grid.Row="1" Grid.Column="1" Style="{StaticResource BarraRecursoEstilo}"/>
                                <TextBlock x:Name="TxtDespues" Grid.Row="1" Grid.Column="2" Style="{StaticResource DatoEstilo}"
                                           FontSize="11" Margin="10,5,0,5"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="TxtBenchmarkDetalle" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap"
                                   Margin="0,12,0,0" Visibility="Collapsed"/>

                        <!-- Sin benchmark -->
                        <StackPanel x:Name="PanelSinBenchmark" Margin="0,14,0,0">
                            <TextBlock Text="&gt; sin_datos" Style="{StaticResource DatoEstilo}"/>
                            <TextBlock Text="Ejecuta un benchmark para medir tu equipo (sección benchmark)."
                                       Style="{StaticResource ExplicacionEstilo}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Perfil: los tres botones existen en el diseño pero aún no hacen nada -->
                <Border Grid.Column="2" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="[ PERFIL ]" Style="{StaticResource EtiquetaEstilo}"/>
                            <Border Style="{StaticResource PastillaEstilo}" HorizontalAlignment="Right" Margin="0">
                                <TextBlock Text="próximamente" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <Border Style="{StaticResource PerfilEstilo}">
                                <TextBlock Text="gaming_extremo" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                            <Border Style="{StaticResource PerfilEstilo}">
                                <TextBlock Text="equilibrado" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                            <Border Style="{StaticResource PerfilEstilo}">
                                <TextBlock Text="batería" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Elegir entre fluidez, consumo y temperatura." Style="{StaticResource ExplicacionEstilo}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
