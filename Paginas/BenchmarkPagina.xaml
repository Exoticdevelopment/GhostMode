<!-- Página Benchmark: mide los FPS de un juego 60 s sin optimizar, aplica Ghost Mode y mide otros 60 s.
     Los números salen de PresentMon (Intel, MIT), que se descarga la primera vez. -->
<Page x:Class="OptimizadorPC.Paginas.BenchmarkPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Benchmark">

    <Page.Resources>
        <!-- Título de cada tarjeta numerada -->
        <Style x:Key="TituloTarjetaEstilo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        </Style>
        <Style x:Key="TextoAyudaEstilo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,36,44,36">
            <TextBlock Text="Benchmark" Style="{StaticResource TituloPaginaEstilo}"/>
            <TextBlock Text="Mide los FPS de tu juego antes y después de Ghost Mode." Style="{StaticResource SubtituloPaginaEstilo}"/>

            <!-- ===== 1. Elegir el juego ===== -->
            <Border Style="{StaticResource TarjetaEstilo}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="1. Elige el juego" Style="{StaticResource TituloTarjetaEstilo}"/>
                    <TextBlock Text="Abre el juego antes y entra en una partida. Aquí aparecen los programas con ventana abierta."
                               Style="{StaticResource TextoAyudaEstilo}" Margin="0,6,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ListaProcesos" SelectionChanged="ListaProcesos_SelectionChanged"/>
                        <ui:Button x:Name="BtnRefrescar" Grid.Column="1" Content="Actualizar" Margin="12,0,0,0"
                                   Style="{StaticResource BotonSecundarioEstilo}" Click="BtnRefrescar_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync20"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 2. Medir ===== -->
            <Border Style="{StaticResource TarjetaEstilo}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="2. Mide" Style="{StaticResource TituloTarjetaEstilo}"/>
                    <!-- Qué va a pasar: se rellena con las optimizaciones reales que faltan -->
                    <TextBlock x:Name="TxtPlan" Style="{StaticResource TextoAyudaEstilo}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtPresentMon" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextoTenueBrush}"/>

                    <!-- Progreso: solo se ve mientras mide -->
                    <StackPanel x:Name="PanelProgreso" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="TxtEtapa" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AvisoBrush}"/>
                            <TextBlock x:Name="TxtRestante" HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="BarraProgreso" Style="{StaticResource BarraRecursoEstilo}" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button x:Name="BtnIniciar" Content="Iniciar benchmark" IsEnabled="False"
                                   Style="{StaticResource BotonPrincipalEstilo}" Click="BtnIniciar_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play20"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="BtnCancelar" Content="Cancelar" Margin="12,0,0,0" Visibility="Collapsed"
                                   Style="{StaticResource BotonSecundarioEstilo}" Click="BtnCancelar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Resultado (el último o el elegido en el historial) ===== -->
            <Border x:Name="TarjetaResultado" Style="{StaticResource TarjetaEstilo}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TxtResJuego" Style="{StaticResource TituloTarjetaEstilo}"/>
                            <TextBlock x:Name="TxtResFecha" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource TextoTenueBrush}"/>
                        </StackPanel>
                        <Border x:Name="PastillaMejora" Style="{StaticResource PastillaEstilo}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0">
                            <TextBlock x:Name="TxtResMejora" Style="{StaticResource PastillaTextoEstilo}"/>
                        </Border>
                    </Grid>

                    <!-- Barras: FPS promedio y 1% low, antes (gris) y después (verde) -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.RowSpan="2" Text="FPS promedio" Style="{StaticResource TextoAyudaEstilo}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Antes" FontSize="12" Foreground="{StaticResource TextoTenueBrush}" Margin="0,4"/>
                        <ProgressBar x:Name="BarraPromAntes" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}"
                                     Foreground="{StaticResource TextoTenueBrush}" Height="6"/>
                        <TextBlock x:Name="TxtPromAntes" Grid.Column="3" FontSize="13" Margin="12,4,0,4" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Después" FontSize="12" Foreground="{StaticResource TextoTenueBrush}" Margin="0,4"/>
                        <ProgressBar x:Name="BarraPromDespues" Grid.Row="1" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}" Height="6"/>
                        <TextBlock x:Name="TxtPromDespues" Grid.Row="1" Grid.Column="3" FontSize="13" FontWeight="SemiBold" Margin="12,4,0,4"
                                   Foreground="{StaticResource ActivoBrush}"/>

                        <TextBlock Grid.Row="2" Grid.RowSpan="2" Text="1% low" Style="{StaticResource TextoAyudaEstilo}"
                                   VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Antes" FontSize="12" Foreground="{StaticResource TextoTenueBrush}" Margin="0,14,0,4"/>
                        <ProgressBar x:Name="BarraLowAntes" Grid.Row="2" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}"
                                     Foreground="{StaticResource TextoTenueBrush}" Height="6" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtLowAntes" Grid.Row="2" Grid.Column="3" FontSize="13" Margin="12,14,0,4" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Después" FontSize="12" Foreground="{StaticResource TextoTenueBrush}" Margin="0,4"/>
                        <ProgressBar x:Name="BarraLowDespues" Grid.Row="3" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}" Height="6"/>
                        <TextBlock x:Name="TxtLowDespues" Grid.Row="3" Grid.Column="3" FontSize="13" FontWeight="SemiBold" Margin="12,4,0,4"
                                   Foreground="{StaticResource ActivoBrush}"/>
                    </Grid>

                    <!-- FPS de cada segundo de las dos mediciones -->
                    <Grid Margin="0,20,0,8">
                        <TextBlock Text="FPS por segundo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextoBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="12" Height="3" Fill="{StaticResource TextoTenueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Antes" FontSize="12" Margin="6,0,14,0" Foreground="{StaticResource TextoSecundarioBrush}"/>
                            <Rectangle Width="12" Height="3" Fill="{StaticResource ActivoBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Con Ghost Mode" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Maximo="0" = el techo se calcula solo con el mayor valor -->
                    <componentes:GraficaLinea x:Name="GraficaFps" Height="120" Maximo="0"
                                              Trazo="{StaticResource ActivoBrush}" TrazoSecundario="{StaticResource TextoTenueBrush}"
                                              Lineas="{StaticResource BordeBrush}"/>
                    <TextBlock x:Name="TxtEscala" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource TextoTenueBrush}"/>

                    <TextBlock x:Name="TxtResOptimizaciones" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                               Foreground="{StaticResource TextoTenueBrush}"/>
                </StackPanel>
            </Border>

            <!-- ===== Historial ===== -->
            <Border Style="{StaticResource TarjetaEstilo}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="20,16">
                        <TextBlock Text="Historial" Style="{StaticResource TituloTarjetaEstilo}"/>
                        <TextBlock Text="Clic en una fila para verla arriba" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource TextoTenueBrush}"/>
                    </Grid>
                    <ItemsControl x:Name="ListaHistorial">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Un botón sin aspecto de botón: toda la fila es clicable -->
                                <Button Click="FilaHistorial_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Padding="0" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fondo" Background="Transparent" BorderBrush="{StaticResource BordeBrush}"
                                                    BorderThickness="0,1,0,0" Padding="20,12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BordeBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Juego}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextoBrush}"/>
                                            <TextBlock Text="{Binding Fecha}" FontSize="11" Foreground="{StaticResource TextoTenueBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Promedio" FontSize="11" Foreground="{StaticResource TextoTenueBrush}"/>
                                            <TextBlock Text="{Binding TextoPromedio}" FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="1% low" FontSize="11" Foreground="{StaticResource TextoTenueBrush}"/>
                                            <TextBlock Text="{Binding Texto1Low}" FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding TextoMejora}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AvisoBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Mejoro}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ActivoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSinHistorial" Text="Todavía no hay benchmarks guardados." FontSize="13"
                               Margin="20,4,20,18" Foreground="{StaticResource TextoSecundarioBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
