<!-- Página Benchmark: mide los FPS de un juego 60 s sin optimizar, aplica Ghost Mode y mide otros 60 s.
     Los números salen de PresentMon (Intel, MIT), que se descarga la primera vez. -->
<Page x:Class="OptimizadorPC.Paginas.BenchmarkPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Benchmark">

    <Page.Resources>
        <!-- Texto de ayuda dentro de los paneles (Segoe: frases) -->
        <Style x:Key="TextoAyudaEstilo" TargetType="TextBlock" BasedOn="{StaticResource ExplicacionEstilo}"/>

        <!-- Fila de la comparación: "antes" / "después" -->
        <Style x:Key="FilaEtiquetaEstilo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaEstilo}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">
            <TextBlock Text="&gt; benchmark" Style="{StaticResource TituloPaginaEstilo}"/>
            <TextBlock Text="Mide los FPS de tu juego antes y después de Ghost Mode." Style="{StaticResource SubtituloPaginaEstilo}"/>

            <!-- ===== Paso 1: elegir el juego (la numeración vale: es una secuencia real) ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="1. elige el juego" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Abre el juego antes y entra en una partida. Aquí aparecen los programas con ventana abierta."
                               Style="{StaticResource TextoAyudaEstilo}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ListaProcesos" FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoTexto}"
                                  SelectionChanged="ListaProcesos_SelectionChanged"/>
                        <ui:Button x:Name="BtnRefrescar" Grid.Column="1" Content="[ actualizar ]" Margin="12,0,0,0"
                                   Style="{StaticResource BotonSecundarioEstilo}" Click="BtnRefrescar_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== Paso 2: medir ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="2. mide" Margin="0,16,0,0">
                <StackPanel>
                    <!-- Qué va a pasar: se rellena con las optimizaciones reales que faltan -->
                    <TextBlock x:Name="TxtPlan" Style="{StaticResource TextoAyudaEstilo}"/>
                    <TextBlock x:Name="TxtPresentMon" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <!-- Progreso: solo se ve mientras mide -->
                    <StackPanel x:Name="PanelProgreso" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="TxtEtapa" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"
                                       Foreground="{StaticResource AvisoBrush}"/>
                            <TextBlock x:Name="TxtRestante" HorizontalAlignment="Right" Style="{StaticResource DatoEstilo}"
                                       Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="BarraProgreso" Style="{StaticResource BarraRecursoEstilo}" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button x:Name="BtnIniciar" Content="[ iniciar benchmark ]" IsEnabled="False"
                                   Style="{StaticResource BotonPrincipalEstilo}" Click="BtnIniciar_Click"/>
                        <ui:Button x:Name="BtnCancelar" Content="[ cancelar ]" Margin="12,0,0,0" Visibility="Collapsed"
                                   Style="{StaticResource BotonSecundarioEstilo}" Click="BtnCancelar_Click"/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== Resultado (el último o el elegido en el historial) ===== -->
            <HeaderedContentControl x:Name="TarjetaResultado" Style="{StaticResource PanelEstilo}" Header="resultado"
                                    Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <!-- Juego y fecha a la izquierda; la mejora, el número de esta pantalla, a la derecha -->
                    <Grid>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtResJuego" Style="{StaticResource DatoEstilo}" FontSize="{StaticResource TamanoDato}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtResFecha" Style="{StaticResource EtiquetaEstilo}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <!-- Verde si mejoró (resultado OK), ámbar si no: lo pone el código -->
                            <TextBlock x:Name="TxtResMejora" Style="{StaticResource DatoEstilo}" FontSize="{StaticResource TamanoHeroe}"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="fps promedio" Style="{StaticResource EtiquetaEstilo}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Barras: FPS promedio y 1% low. Antes = gris; después (con Ghost Mode) = morado -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.RowSpan="2" Text="fps promedio" Style="{StaticResource DatoEstilo}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="antes" Style="{StaticResource FilaEtiquetaEstilo}"/>
                        <ProgressBar x:Name="BarraPromAntes" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}"
                                     Foreground="{StaticResource TextoSecundarioBrush}" Height="6"/>
                        <TextBlock x:Name="TxtPromAntes" Grid.Column="3" Style="{StaticResource DatoEstilo}" Margin="12,4,0,4"
                                   Foreground="{StaticResource TextoSecundarioBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="después" Style="{StaticResource FilaEtiquetaEstilo}"/>
                        <ProgressBar x:Name="BarraPromDespues" Grid.Row="1" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}"
                                     Foreground="{StaticResource AcentoBrush}" Height="6"/>
                        <TextBlock x:Name="TxtPromDespues" Grid.Row="1" Grid.Column="3" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"
                                   Margin="12,4,0,4" Foreground="{StaticResource AcentoBrilloBrush}"/>

                        <TextBlock Grid.Row="2" Grid.RowSpan="2" Text="1% low" Style="{StaticResource DatoEstilo}"
                                   VerticalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="antes" Style="{StaticResource FilaEtiquetaEstilo}" Margin="0,14,0,4"/>
                        <ProgressBar x:Name="BarraLowAntes" Grid.Row="2" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}"
                                     Foreground="{StaticResource TextoSecundarioBrush}" Height="6" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtLowAntes" Grid.Row="2" Grid.Column="3" Style="{StaticResource DatoEstilo}" Margin="12,14,0,4"
                                   Foreground="{StaticResource TextoSecundarioBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="después" Style="{StaticResource FilaEtiquetaEstilo}"/>
                        <ProgressBar x:Name="BarraLowDespues" Grid.Row="3" Grid.Column="2" Style="{StaticResource BarraRecursoEstilo}"
                                     Foreground="{StaticResource AcentoBrush}" Height="6"/>
                        <TextBlock x:Name="TxtLowDespues" Grid.Row="3" Grid.Column="3" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"
                                   Margin="12,4,0,4" Foreground="{StaticResource AcentoBrilloBrush}"/>
                    </Grid>

                    <!-- FPS de cada segundo de las dos mediciones -->
                    <Grid Margin="0,22,0,8">
                        <TextBlock Text="fps por segundo" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="12" Height="2" Fill="{StaticResource TextoSecundarioBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="antes" Style="{StaticResource EtiquetaEstilo}" Margin="6,0,14,0"/>
                            <Rectangle Width="12" Height="2" Fill="{StaticResource AcentoBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="con ghost_mode" Style="{StaticResource EtiquetaEstilo}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- Maximo="0" = el techo se calcula solo con el mayor valor -->
                    <componentes:GraficaLinea x:Name="GraficaFps" Height="120" Maximo="0"
                                              Trazo="{StaticResource AcentoBrush}" TrazoSecundario="{StaticResource TextoSecundarioBrush}"
                                              Lineas="{StaticResource BordeBrush}"/>
                    <TextBlock x:Name="TxtEscala" Style="{StaticResource EtiquetaEstilo}" Margin="0,6,0,0"/>

                    <TextBlock x:Name="TxtResOptimizaciones" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== Historial ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="historial" Tag="clic en una fila para verla arriba"
                                    Margin="0,16,0,0" Padding="0,12,0,4">
                <StackPanel>
                    <ItemsControl x:Name="ListaHistorial" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Un botón sin aspecto de botón: toda la fila es clicable (por eso SÍ reacciona al ratón).
                                     La primera fila no lleva línea arriba (AlternationIndex = 0) -->
                                <Button Click="FilaHistorial_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Padding="0" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fondo" Background="Transparent" BorderBrush="{StaticResource BordeBrush}"
                                                    BorderThickness="0,1,0,0" Padding="16,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                             RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                    <Setter TargetName="Fondo" Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background" Value="{StaticResource TarjetaBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background" Value="{StaticResource TarjetaBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Juego}" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Fecha}" Style="{StaticResource EtiquetaEstilo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="promedio" Style="{StaticResource EtiquetaEstilo}"/>
                                            <TextBlock Text="{Binding TextoPromedio}" Style="{StaticResource DatoEstilo}"
                                                       Foreground="{StaticResource TextoSecundarioBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="1% low" Style="{StaticResource EtiquetaEstilo}"/>
                                            <TextBlock Text="{Binding Texto1Low}" Style="{StaticResource DatoEstilo}"
                                                       Foreground="{StaticResource TextoSecundarioBrush}"/>
                                        </StackPanel>
                                        <!-- Verde si mejoró (resultado OK), ámbar si no -->
                                        <TextBlock Grid.Column="3" Text="{Binding TextoMejora}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DatoEstilo}">
                                                    <Setter Property="Foreground" Value="{StaticResource AvisoBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Mejoro}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ExitoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSinHistorial" Text="&gt; sin benchmarks guardados todavía" Style="{StaticResource DatoEstilo}"
                               Foreground="{StaticResource TextoSecundarioBrush}" Margin="16,4,16,14"/>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
