<!-- Página Limpieza: "analizar" mide cada categoría; las casillas [x] eligen qué borrar.
     Nada se borra hasta pulsar "limpiar seleccionados" y confirmar. -->
<Page x:Class="OptimizadorPC.Paginas.LimpiezaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Limpieza">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">

            <!-- Encabezado: título a la izquierda, "analizar" a la derecha -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="&gt; limpieza" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock Text="Recupera espacio sin tocar tus archivos personales." Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <ui:Button x:Name="BtnAnalizar" Grid.Column="1" Content="[ analizar ]" VerticalAlignment="Top"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnAnalizar_Click"/>
            </Grid>

            <!-- ===== Resumen: el espacio recuperable (el número de esta pantalla) + estado y disco.
                 El Tag ("a las 14:32") lo pone el código al terminar un análisis ===== -->
            <HeaderedContentControl x:Name="PanelResumen" Style="{StaticResource PanelEstilo}" Header="resumen" Margin="0,20,0,0"
                                    Padding="20,22,20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock x:Name="TxtRecuperable" Text="—" Style="{StaticResource DatoEstilo}"
                                   FontSize="{StaticResource TamanoHeroe}" FontWeight="SemiBold"/>
                        <TextBlock Text="recuperable" Style="{StaticResource EtiquetaEstilo}"/>
                    </StackPanel>

                    <!-- Estado del análisis y disco, separados por una línea vertical -->
                    <Border Grid.Column="1" BorderBrush="{StaticResource BordeBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Cuadradito de estado: el color lo pone el código (ámbar trabajando, verde OK) -->
                                <Rectangle x:Name="IconoAnalisis" Width="8" Height="8" VerticalAlignment="Center"
                                           Fill="{StaticResource TextoSecundarioBrush}"/>
                                <TextBlock x:Name="TxtAnalisis" Text="sin analizar" Margin="10,0,0,0"
                                           Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDisco" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap" Margin="0,10,0,8"/>
                            <ProgressBar x:Name="BarraDisco" Style="{StaticResource BarraRecursoEstilo}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </HeaderedContentControl>

            <!-- ===== Categorías. El Tag ("3 de 5 marcadas") lo pone el código ===== -->
            <HeaderedContentControl x:Name="PanelCategorias" Style="{StaticResource PanelEstilo}" Header="categorías"
                                    Margin="0,16,0,0" Padding="0,10,0,4">
                <!-- ItemsControl = repite la plantilla para cada CategoriaLimpiezaVM.
                     AlternationCount: WPF numera las filas; la PRIMERA no lleva línea arriba -->
                <ItemsControl x:Name="ListaCategorias" AlternationCount="1000">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                         RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- "[ ]" / "[x]" (CasillaEstilo de Controles.xaml) -->
                                    <CheckBox IsChecked="{Binding Seleccionada, Mode=TwoWay}" Style="{StaticResource CasillaEstilo}"
                                              VerticalAlignment="Top" ToolTip="{Binding Nombre}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Descripcion}" Style="{StaticResource ExplicacionEstilo}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <!-- Tamaño en mono y alineado a la derecha: así los MB se comparan de un vistazo -->
                                    <TextBlock Grid.Column="2" Text="{Binding TextoTamano}" Style="{StaticResource DatoEstilo}"
                                               FontWeight="SemiBold" MinWidth="90" TextAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>

            <!-- ===== Pie: total seleccionado y botón ===== -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTotal" Text="Pulsa «[ analizar ]» para medir cuánto espacio puedes recuperar."
                           Style="{StaticResource DatoEstilo}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <ui:Button x:Name="BtnLimpiar" Grid.Column="1" Content="[ limpiar seleccionados ]" IsEnabled="False"
                           Margin="16,0,0,0" Style="{StaticResource BotonPrincipalEstilo}" Click="BtnLimpiar_Click"/>
            </Grid>

            <!-- Las dos notas juntas, en una sola nota -->
            <Border Style="{StaticResource NotaEstilo}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource NotaTextoEstilo}"
                               Text="No se borrarán documentos, descargas ni partidas guardadas. Los archivos en uso o modificados en las últimas 24 horas se saltan."/>
                    <TextBlock x:Name="TxtNotaShaders" Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,0"
                               Text="La caché de shaders se conservará para evitar tirones."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
