<!-- Página Limpieza: "Analizar" mide cada categoría; las casillas eligen qué borrar.
     Nada se borra hasta pulsar "Limpiar seleccionados" y confirmar. -->
<Page x:Class="OptimizadorPC.Paginas.LimpiezaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Limpieza">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,36,44,36">

            <!-- Encabezado: título a la izquierda, "Analizar" a la derecha -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Limpieza" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock Text="Recupera espacio sin tocar tus archivos personales." Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <ui:Button x:Name="BtnAnalizar" Grid.Column="1" Content="Analizar" VerticalAlignment="Top"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnAnalizar_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ScanDash20"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- ===== Fila de resumen: espacio recuperable + estado del análisis y del disco ===== -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource TarjetaEstilo}">
                    <StackPanel>
                        <TextBlock Text="ESPACIO RECUPERABLE" Style="{StaticResource EtiquetaEstilo}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="TxtRecuperable" Text="—" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextoBrush}"/>
                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource ActivoBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TarjetaEstilo}">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="IconoAnalisis" Symbol="Info20" FontSize="18"
                                           Foreground="{StaticResource TextoSecundarioBrush}"/>
                            <TextBlock x:Name="TxtAnalisis" Text="Sin analizar" FontSize="14" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextoBrush}"/>
                            <Border x:Name="PastillaHora" Style="{StaticResource PastillaEstilo}" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="TxtHora" Style="{StaticResource PastillaTextoEstilo}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtDisco" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10"
                                   Foreground="{StaticResource TextoSecundarioBrush}"/>
                        <ProgressBar x:Name="BarraDisco" Style="{StaticResource BarraRecursoEstilo}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Lista de categorías ===== -->
            <Border Style="{StaticResource TarjetaEstilo}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="20,16">
                        <TextBlock Text="Selecciona qué limpiar" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextoBrush}"/>
                        <TextBlock x:Name="TxtCuantas" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource TextoSecundarioBrush}"/>
                    </Grid>

                    <!-- ItemsControl = repite la plantilla para cada CategoriaLimpiezaVM -->
                    <ItemsControl x:Name="ListaCategorias">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Cada fila con una línea arriba que la separa de la anterior -->
                                <Border BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- MinWidth="0": el CheckBox de WPF-UI reserva sitio para un texto que aquí no hay -->
                                        <CheckBox IsChecked="{Binding Seleccionada, Mode=TwoWay}" MinWidth="0"
                                                  VerticalAlignment="Center" ToolTip="{Binding Nombre}"/>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icono}" FontSize="20" Margin="8,0,14,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextoSecundarioBrush}"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextoBrush}"/>
                                            <TextBlock Text="{Binding Descripcion}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextoTenueBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding TextoTamano}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="16,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextoBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Pie: total seleccionado y botón ===== -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotal" Text="Pulsa «Analizar» para medir cuánto espacio puedes recuperar."
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextoBrush}"/>
                    <TextBlock x:Name="TxtNotaShaders" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource TextoTenueBrush}"
                               Text="La caché de shaders se conservará para evitar tirones."/>
                </StackPanel>
                <ui:Button x:Name="BtnLimpiar" Grid.Column="1" Content="Limpiar seleccionados" IsEnabled="False"
                           Margin="16,0,0,0" Style="{StaticResource BotonPrincipalEstilo}" Click="BtnLimpiar_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Broom20"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <TextBlock Text="No se borrarán documentos, descargas ni partidas guardadas. Los archivos en uso o modificados en las últimas 24 horas se saltan."
                       FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{StaticResource TextoTenueBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
