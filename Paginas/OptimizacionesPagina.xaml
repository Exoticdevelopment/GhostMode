<!-- Página Optimizaciones: una columna por categoría con sus tarjetas.
     Los interruptores marcan lo que el usuario QUIERE; nada cambia en Windows hasta pulsar "Aplicar". -->
<Page x:Class="OptimizadorPC.Paginas.OptimizacionesPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Optimizaciones">

    <Page.Resources>
        <!-- Pastilla de filtro ("Todos los ajustes" / "Solo seguros").
             Es un RadioButton: de un mismo grupo solo puede estar marcado uno -->
        <Style x:Key="FiltroEstilo" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fondo" CornerRadius="4" Padding="10,4" Background="{StaticResource BordeBrush}">
                            <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ActivoSuaveBrush}"/>
                                <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource ActivoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ScrollViewer = si la ventana es pequeña, aparece una barra para desplazarse -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,36,44,36">

            <!-- Encabezado: título y subtítulo a la izquierda, botón Aplicar a la derecha -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Optimizaciones" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="Leyendo hardware…" Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <ui:Button x:Name="BtnAplicar" Grid.Column="1" Content="Sin cambios" IsEnabled="False"
                           VerticalAlignment="Top" Style="{StaticResource BotonPrincipalEstilo}" Click="BtnAplicar_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Checkmark20"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- Filtros a la izquierda, "N de M seleccionados" a la derecha -->
            <Grid Margin="0,24,0,20">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FiltroTodos" Content="Todos los ajustes" GroupName="Filtro" IsChecked="True"
                                 Style="{StaticResource FiltroEstilo}" Checked="Filtro_Checked"/>
                    <RadioButton x:Name="FiltroSeguros" Content="Solo seguros" GroupName="Filtro"
                                 Style="{StaticResource FiltroEstilo}" Checked="Filtro_Checked"/>
                </StackPanel>
                <TextBlock x:Name="TxtSeleccionados" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextoSecundarioBrush}"/>
            </Grid>

            <!-- Las columnas. ItemsControl = repite la plantilla para cada GrupoCategoria.
                 UniformGrid Rows="1" = todas en una fila, del mismo ancho -->
            <ItemsControl x:Name="ListaCategorias">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,16,0">
                            <!-- Encabezado de la columna: icono verde + nombre -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="{Binding Icono}" FontSize="20" Foreground="{StaticResource ActivoBrush}"/>
                                <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextoBrush}"/>
                            </StackPanel>
                            <!-- Y dentro, otra lista: una tarjeta por optimización -->
                            <ItemsControl ItemsSource="{Binding Optimizaciones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <componentes:TarjetaOptimizacion Margin="0,0,0,16"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Aviso naranja: solo se ve si hay ajustes de riesgo Moderado en pantalla -->
            <Border x:Name="AvisoModerado" Visibility="Collapsed" Background="{StaticResource AvisoSuaveBrush}"
                    CornerRadius="8" Padding="18,14" Margin="0,8,16,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning20" FontSize="20" Foreground="{StaticResource AvisoBrush}"/>
                    <TextBlock Text="Los ajustes de riesgo moderado pueden cambiar el comportamiento de algunas apps. Todos se pueden deshacer."
                               FontSize="13" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AvisoBrush}"/>
                </StackPanel>
            </Border>

            <!-- Se oculta cuando el punto de restauración de esta sesión ya está hecho -->
            <StackPanel x:Name="FilaPuntoRestauracion" Orientation="Horizontal" Margin="0,20,0,0">
                <ui:SymbolIcon Symbol="ShieldCheckmark20" FontSize="18" Foreground="{StaticResource ActivoBrush}"/>
                <TextBlock Text="Se creará un punto de restauración antes de aplicar cambios." FontSize="13"
                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextoSecundarioBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
