<!-- Página Optimizaciones: un panel por categoría con sus ajustes en FILAS, como un archivo de configuración.
     Los interruptores marcan lo que el usuario QUIERE; nada cambia en Windows hasta pulsar "aplicar". -->
<Page x:Class="OptimizadorPC.Paginas.OptimizacionesPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Optimizaciones">

    <Page.Resources>
        <!-- Filtro "[ todos ]" / "[ solo seguros ]". Es un RadioButton: de un mismo grupo solo puede estar marcado uno.
             Elegido: borde morado y texto morado claro (morado sobre negro) -->
        <Style x:Key="FiltroEstilo" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fondo" CornerRadius="2" BorderThickness="1" Padding="10,4"
                                BorderBrush="{StaticResource BordeBrush}" Background="Transparent">
                            <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" FontFamily="{StaticResource FuenteMono}"
                                       FontSize="{StaticResource TamanoEtiqueta}" Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource BordeHoverBrush}"/>
                                <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource TextoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                                <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource AcentoBrilloBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ScrollViewer = si la ventana es pequeña, aparece una barra para desplazarse -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">

            <!-- Encabezado: título y subtítulo a la izquierda, botón Aplicar a la derecha -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="&gt; optimizaciones" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="Leyendo hardware…" Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <!-- El texto ("[ aplicar +2 −1 ]") lo pone el código: +N se activan, −N se desactivan -->
                <ui:Button x:Name="BtnAplicar" Grid.Column="1" Content="[ sin cambios ]" IsEnabled="False"
                           VerticalAlignment="Top" Style="{StaticResource BotonPrincipalEstilo}" Click="BtnAplicar_Click"/>
            </Grid>

            <!-- Filtros a la izquierda, "N de M seleccionados" a la derecha -->
            <Grid Margin="0,20,0,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FiltroTodos" Content="[ todos ]" GroupName="Filtro" IsChecked="True"
                                 Style="{StaticResource FiltroEstilo}" Checked="Filtro_Checked"/>
                    <RadioButton x:Name="FiltroSeguros" Content="[ solo seguros ]" GroupName="Filtro"
                                 Style="{StaticResource FiltroEstilo}" Checked="Filtro_Checked"/>
                </StackPanel>
                <TextBlock x:Name="TxtSeleccionados" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource EtiquetaEstilo}"/>
            </Grid>

            <!-- Las categorías. ItemsControl = repite la plantilla para cada GrupoCategoria, una debajo de otra -->
            <ItemsControl x:Name="ListaCategorias">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Un panel por categoría: el título ("energía") va en el borde -->
                        <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="{Binding Nombre}"
                                                Margin="0,12,0,0" Padding="0,10,0,4">
                            <!-- Y dentro, otra lista: una fila por optimización.
                                 AlternationCount: WPF numera cada fila (0, 1, 2...) en ItemsControl.AlternationIndex;
                                 lo usamos para que la PRIMERA no lleve línea arriba -->
                            <ItemsControl ItemsSource="{Binding Optimizaciones}" AlternationCount="1000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex),
                                                                     RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <componentes:FilaOptimizacion/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </HeaderedContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Aviso ámbar: solo se ve si hay ajustes de riesgo moderado en pantalla -->
            <Border x:Name="AvisoModerado" Visibility="Collapsed" Style="{StaticResource NotaEstilo}"
                    BorderBrush="{StaticResource AvisoBrush}" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource NotaTextoEstilo}"
                           Text="Los ajustes de riesgo moderado pueden cambiar el comportamiento de algunas apps. Todos se pueden deshacer."/>
            </Border>

            <!-- Se oculta cuando el punto de restauración de esta sesión ya está hecho -->
            <TextBlock x:Name="FilaPuntoRestauracion" Style="{StaticResource EtiquetaEstilo}" Margin="0,16,0,0"
                       TextWrapping="Wrap" Text="* se creará un punto de restauración antes de aplicar cambios"/>
        </StackPanel>
    </ScrollViewer>
</Page>
