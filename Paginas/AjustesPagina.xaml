<!-- Página Ajustes: paneles "general" (inicio con Windows, atajo global, bienvenida), "diagnóstico",
     "solución de problemas" y "acerca de" (nombre,
     versión leída del ensamblado, autor, enlaces y licencia). Los textos con x:Name los rellena AjustesPagina.xaml.cs -->
<Page x:Class="OptimizadorPC.Paginas.AjustesPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Ajustes">

    <Page.Resources>
        <!-- Columna izquierda de cada fila: el nombre del dato, como en una salida de consola -->
        <Style x:Key="ClaveEstilo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaEstilo}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style x:Key="ValorEstilo" TargetType="TextBlock" BasedOn="{StaticResource DatoEstilo}">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">
            <componentes:PromptTerminal Comando="config"/>
            <TextBlock Text="Arranque, atajo de teclado e información de la aplicación." Style="{StaticResource SubtituloPaginaEstilo}"/>

            <!-- ===== General ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="general" Margin="0,20,0,0" Padding="0,8,0,0">
                <StackPanel>

                    <!-- Iniciar con Windows -->
                    <Grid Margin="16,14,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Iniciar con Windows (minimizado)" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,0"
                                       Text="Se abre en la bandeja al iniciar sesión, para que Modo Gaming vigile tus juegos. Usa el Programador de tareas con privilegios elevados: no pide permiso de administrador en cada arranque. Al apagarlo se borra la tarea."/>
                        </StackPanel>
                        <componentes:InterruptorEstado x:Name="IntInicioWindows" Grid.Column="1" VerticalAlignment="Center"
                                                       Click="IntInicioWindows_Click"/>
                    </Grid>

                    <!-- Atajo global -->
                    <Border BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Atajo para activar/desactivar Ghost Mode" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,10"
                                       Text="Funciona desde cualquier sitio, también dentro del juego. Haz clic en el cuadro y pulsa la combinación (con Ctrl, Alt o Win)."/>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="TxtAtajo" Width="200" IsReadOnly="True" FontFamily="{StaticResource FuenteMono}"
                                            FontSize="12" PlaceholderText="sin atajo" PreviewKeyDown="TxtAtajo_PreviewKeyDown"/>
                                <ui:Button x:Name="BtnGuardarAtajo" Content="[ guardar ]" Margin="8,0,0,0" IsEnabled="False"
                                           Style="{StaticResource BotonPrincipalEstilo}" Click="BtnGuardarAtajo_Click"/>
                                <ui:Button Content="[ quitar ]" Margin="8,0,0,0" Style="{StaticResource BotonSecundarioEstilo}"
                                           Click="BtnQuitarAtajo_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtEstadoAtajo" Style="{StaticResource EtiquetaEstilo}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Bienvenida -->
                    <Border BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                        <Grid>
                            <StackPanel Margin="0,0,180,0">
                                <TextBlock Text="Bienvenida y diagnóstico" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,0"
                                           Text="Vuelve a ver los 3 pasos y el diagnóstico rápido de tu equipo."/>
                            </StackPanel>
                            <ui:Button Content="[ ver bienvenida ]" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource BotonSecundarioEstilo}" Click="BtnBienvenida_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== Diagnóstico para enviar ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="diagnóstico" Margin="0,16,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <Grid Margin="16,14">
                        <StackPanel Margin="0,0,220,0">
                            <TextBlock Text="Exportar diagnóstico" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,0"
                                       Text="Crea un .zip con el log, los cambios guardados, la configuración y un resumen del equipo, para enviarlo si algo falla. Sin datos personales: se quitan tu usuario, el nombre del equipo y las IP de tu red."/>
                        </StackPanel>
                        <ui:Button x:Name="BtnExportar" Content="[ exportar diagnóstico ]" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource BotonSecundarioEstilo}"
                                   Click="BtnExportar_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== Solución de problemas: cosas que arreglan fallos concretos, NO dan rendimiento ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="solución de problemas" Margin="0,16,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Desactivar MPO (parpadeos de pantalla)" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,0"
                                       Text="Solo si ves parpadeos o tirones en el escritorio, en ventanas o en el navegador. NO da FPS. Es el arreglo que publicó NVIDIA para algunos drivers; en Windows 11 reciente puede no tener efecto. Afecta a todo el sistema y necesita reiniciar Windows. Se deshace aquí o con «Deshacer todo»."/>
                            <TextBlock x:Name="TxtMpo" Style="{StaticResource EtiquetaEstilo}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <componentes:InterruptorEstado x:Name="IntMpo" Grid.Column="1" VerticalAlignment="Center"
                                                       Click="IntMpo_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="acerca de" Margin="0,16,0,0" Padding="0,8,0,0">
                <StackPanel>

                    <Grid Margin="16,10,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="app" Style="{StaticResource ClaveEstilo}"/>
                        <TextBlock x:Name="TxtNombre" Grid.Column="1" Style="{StaticResource ValorEstilo}"/>

                        <TextBlock Grid.Row="1" Text="versión" Style="{StaticResource ClaveEstilo}"/>
                        <TextBlock x:Name="TxtVersion" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValorEstilo}"/>

                        <TextBlock Grid.Row="2" Text="autor" Style="{StaticResource ClaveEstilo}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValorEstilo}"
                                   Text="Creado por Miguel Ángel González (@Exoticdevelopment)"/>

                        <TextBlock Grid.Row="3" Text="perfil" Style="{StaticResource ClaveEstilo}"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="https://github.com/Exoticdevelopment"
                                Tag="https://github.com/Exoticdevelopment" Style="{StaticResource EnlaceEstilo}"
                                FontSize="13" Margin="0,5" VerticalAlignment="Center" Click="Enlace_Click"/>

                        <TextBlock Grid.Row="4" Text="repositorio" Style="{StaticResource ClaveEstilo}"/>
                        <Button Grid.Row="4" Grid.Column="1" Content="https://github.com/Exoticdevelopment/GhostMode"
                                Tag="https://github.com/Exoticdevelopment/GhostMode" Style="{StaticResource EnlaceEstilo}"
                                FontSize="13" Margin="0,5" VerticalAlignment="Center" Click="Enlace_Click"/>

                        <TextBlock Grid.Row="5" Text="licencia" Style="{StaticResource ClaveEstilo}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="MIT" Style="{StaticResource ValorEstilo}"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
