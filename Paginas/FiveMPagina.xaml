<!-- Página FiveM: estado de la instalación, GPU dedicada (reversible) y limpieza de caché.
     Todos los textos con x:Name se rellenan desde el código con datos reales -->
<Page x:Class="OptimizadorPC.Paginas.FiveMPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="FiveM">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">

            <!-- Encabezado: título a la izquierda, "volver a buscar" a la derecha -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="&gt; fivem" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock Text="Ajustes para jugar en servidores de FiveM." Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <ui:Button x:Name="BtnBuscar" Grid.Column="1" Content="[ volver a buscar ]" VerticalAlignment="Top"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnBuscar_Click"/>
            </Grid>

            <!-- ===== Estado de la instalación ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="instalación" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtEstado" Text="&gt; buscando fivem..." Style="{StaticResource DatoEstilo}"
                                   FontSize="{StaticResource TamanoDato}" FontWeight="SemiBold"/>
                        <!-- La ruta puede ser larga: que salte de línea en vez de cortarse -->
                        <TextBlock x:Name="TxtRuta" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Pastilla "abierto" / "cerrado": el borde se vuelve ámbar si está abierto (lo pone el código) -->
                    <Border x:Name="PastillaAbierto" Grid.Column="1" Style="{StaticResource PastillaEstilo}"
                            VerticalAlignment="Center" Margin="0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtAbierto" Style="{StaticResource PastillaTextoEstilo}"/>
                    </Border>
                </Grid>
            </HeaderedContentControl>

            <!-- Aviso ámbar: solo se ve con FiveM abierto -->
            <Border x:Name="AvisoAbierto" Style="{StaticResource NotaEstilo}" BorderBrush="{StaticResource AvisoBrush}"
                    Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource NotaTextoEstilo}"
                           Text="FiveM está abierto. Ciérralo para limpiar la caché; la GPU dedicada se notará la próxima vez que lo abras."/>
            </Border>

            <!-- ===== Los dos paneles, cada uno con su botón DENTRO y abajo a la izquierda.
                 ZonaAjustes se desactiva entera si FiveM no está instalado ===== -->
            <Grid x:Name="ZonaAjustes" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Izquierda: GPU dedicada (la TarjetaOptimizacion, sin marco, dentro del panel) -->
                <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="gpu">
                    <StackPanel>
                        <componentes:TarjetaOptimizacion x:Name="TarjetaGpu"/>
                        <TextBlock x:Name="TxtEjecutables" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <ui:Button x:Name="BtnAplicarGpu" Content="[ sin cambios ]" IsEnabled="False" HorizontalAlignment="Left"
                                   Margin="0,14,0,0" Style="{StaticResource BotonPrincipalEstilo}" Click="BtnAplicarGpu_Click"/>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Derecha: caché -->
                <HeaderedContentControl Grid.Column="2" Style="{StaticResource PanelEstilo}" Header="caché">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ExplicacionEstilo}"
                                   Text="Archivos que descargan los servidores. Si crece mucho o se daña provoca tirones y cierres; FiveM vuelve a descargar lo que necesite."/>

                        <TextBlock x:Name="TxtTamano" Text="—" Style="{StaticResource DatoEstilo}" FontSize="{StaticResource TamanoTitulo}"
                                   FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="se conservan los archivos del juego (cache\game y game-storage)" Style="{StaticResource EtiquetaEstilo}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <ui:Button x:Name="BtnLimpiar" Content="[ limpiar caché ]" IsEnabled="False" HorizontalAlignment="Left"
                                   Margin="0,14,0,0" Style="{StaticResource BotonSecundarioEstilo}" Click="BtnLimpiar_Click"/>
                    </StackPanel>
                </HeaderedContentControl>
            </Grid>

            <!-- ===== Diagnóstico de gráficos (solo lectura): vale aunque FiveM aún no esté instalado ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="diagnóstico de gráficos" Tag="solo lectura"
                                    Margin="0,16,0,0" Padding="20,22,20,16">
                <StackPanel>
                    <TextBlock x:Name="TxtEquipoGraficos" Text="leyendo el equipo..." Style="{StaticResource DatoEstilo}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSettingsGta" Style="{StaticResource EtiquetaEstilo}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <ItemsControl x:Name="ListaConsejosGraficos" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="6" Height="6" Margin="0,6,10,0" VerticalAlignment="Top" Fill="{Binding Color}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource ExplicacionEstilo}"
                                               Foreground="{StaticResource TextoBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="* Ghost Mode no cambia los gráficos del juego: cámbialos en Ajustes › Gráficos dentro de FiveM."/>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
