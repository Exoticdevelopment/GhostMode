<!-- Página Inicio de Windows: una línea de estado (arranque, habilitados, desactivados) y la tabla de
     programas que arrancan con Windows, con un interruptor cada uno.
     Desactivar NO borra nada: se marca como deshabilitado igual que en el Administrador de tareas. -->
<Page x:Class="OptimizadorPC.Paginas.InicioWindowsPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Inicio de Windows">

    <Page.Resources>
        <!-- Las 4 columnas de la tabla. Cabecera y filas usan las mismas proporciones, así quedan alineadas -->
        <Style x:Key="CabeceraEstilo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaEstilo}"/>
        <Style x:Key="CeldaEstilo" TargetType="TextBlock" BasedOn="{StaticResource ExplicacionEstilo}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Línea de estado: "etiqueta  VALOR", varias seguidas -->
        <Style x:Key="EstadoEtiquetaEstilo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaEstilo}">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,8,3"/>
        </Style>
        <Style x:Key="EstadoValorEstilo" TargetType="TextBlock" BasedOn="{StaticResource DatoEstilo}">
            <Setter Property="FontSize" Value="{StaticResource TamanoTitulo}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,32,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">

            <!-- Encabezado -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <componentes:PromptTerminal Comando="startup"/>
                    <TextBlock Text="Un arranque más ligero empieza con menos programas." Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <ui:Button x:Name="BtnActualizar" Grid.Column="1" Content="[ actualizar ]" VerticalAlignment="Top"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnActualizar_Click"/>
            </Grid>

            <!-- ===== Línea de estado: los tres datos en una fila, sin tarjetas ni iconos ===== -->
            <WrapPanel Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="último arranque" Style="{StaticResource EstadoEtiquetaEstilo}"/>
                    <TextBlock x:Name="TxtTiempo" Text="—" Style="{StaticResource EstadoValorEstilo}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="habilitados" Style="{StaticResource EstadoEtiquetaEstilo}"/>
                    <TextBlock x:Name="TxtHabilitados" Text="—" Style="{StaticResource EstadoValorEstilo}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="desactivados" Style="{StaticResource EstadoEtiquetaEstilo}"/>
                    <TextBlock x:Name="TxtDeshabilitados" Text="—" Style="{StaticResource EstadoValorEstilo}"/>
                </StackPanel>
            </WrapPanel>

            <!-- ===== La tabla, dentro del panel "programas" ===== -->
            <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="programas" Margin="0,18,0,0" Padding="0,12,0,4">
                <StackPanel>
                    <!-- Cabecera -->
                    <Grid Margin="16,4,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="programa" Style="{StaticResource CabeceraEstilo}"/>
                        <TextBlock Grid.Column="1" Text="editor" Style="{StaticResource CabeceraEstilo}"/>
                        <TextBlock Grid.Column="2" Text="origen" Style="{StaticResource CabeceraEstilo}"/>
                        <TextBlock Grid.Column="3" Text="al iniciar" Style="{StaticResource CabeceraEstilo}"/>
                    </Grid>

                    <ItemsControl x:Name="ListaProgramas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Programa: nombre en mono. Al pasar el ratón se ve el comando completo -->
                                        <TextBlock Text="{Binding Nombre}" ToolTip="{Binding Comando}" Style="{StaticResource DatoEstilo}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Editor}" Style="{StaticResource CeldaEstilo}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TextoOrigen}" Style="{StaticResource CeldaEstilo}"/>
                                        <componentes:InterruptorEstado Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                       IsChecked="{Binding Habilitado, Mode=TwoWay}"
                                                                       Estado="{Binding Estado}" ToolTip="{Binding Nombre}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sin programas (o leyendo) -->
                    <TextBlock x:Name="TxtVacio" Text="&gt; leyendo programas de inicio..." Style="{StaticResource DatoEstilo}"
                               Margin="16,8,16,14" TextWrapping="Wrap"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ===== Nota de abajo (información: gris, sin color) ===== -->
            <Border Style="{StaticResource NotaEstilo}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource NotaTextoEstilo}"
                               Text="Desactivar un programa no lo desinstala. Los cambios se aplicarán en el próximo inicio de Windows."/>
                    <TextBlock x:Name="TxtOcultos" Style="{StaticResource ExplicacionEstilo}" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
