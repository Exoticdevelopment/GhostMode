<!-- Página Monitor: CPU, RAM, GPU, disco y temperatura de la GPU de los últimos 60 segundos, actualizados cada 1 s.
     Solo mide mientras la página está a la vista (y no está en pausa). -->
<Page x:Class="OptimizadorPC.Paginas.MonitorPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
      Title="Monitor">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32">

            <!-- Encabezado: título a la izquierda, pausar a la derecha -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="&gt; monitor" Style="{StaticResource TituloPaginaEstilo}"/>
                    <TextBlock Text="Uso del equipo en los últimos 60 segundos." Style="{StaticResource SubtituloPaginaEstilo}"/>
                </StackPanel>
                <ui:Button x:Name="BtnPausar" Grid.Column="1" Content="[ pausar ]" VerticalAlignment="Top"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnPausar_Click"/>
            </Grid>

            <!-- "en vivo, cada 1 s" y el procesador -->
            <Grid Margin="0,18,0,4">
                <StackPanel Orientation="Horizontal">
                    <!-- Cuadradito: claro = midiendo, gris = en pausa -->
                    <Rectangle x:Name="PuntoVivo" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                               Fill="{StaticResource TextoBrush}"/>
                    <TextBlock x:Name="TxtVivo" Text="en vivo, cada 1 s" Style="{StaticResource EtiquetaEstilo}"
                               Foreground="{StaticResource TextoBrush}"/>
                </StackPanel>
                <TextBlock x:Name="TxtProcesador" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource EtiquetaEstilo}"/>
            </Grid>

            <!-- Los 4 paneles en 2 × 2. Los márgenes negativos compensan el hueco de la última columna/fila -->
            <UniformGrid Columns="2" Margin="0,8,-16,-16">
                <componentes:TarjetaGrafica x:Name="TarjetaCpu" Titulo="cpu" EtiquetaMaximo="100 %" Margin="0,0,16,16"/>
                <componentes:TarjetaGrafica x:Name="TarjetaRam" Titulo="ram" EtiquetaMaximo="100 %" Margin="0,0,16,16"/>
                <componentes:TarjetaGrafica x:Name="TarjetaGpu" Titulo="gpu" EtiquetaMaximo="100 %" Margin="0,0,16,16"/>
                <componentes:TarjetaGrafica x:Name="TarjetaDisco" Titulo="disco" EtiquetaMaximo="100 %" Margin="0,0,16,16"/>
            </UniformGrid>

            <!-- Temperatura de la GPU (NVML, solo NVIDIA), a lo ancho: el techo de la gráfica es 100 °C -->
            <componentes:TarjetaGrafica x:Name="TarjetaTemp" Titulo="temp gpu" EtiquetaMaximo="100 °C" Valor="N/D" Margin="0,16,0,0"/>

            <!-- Pie: consumo de la propia app y estado de los sensores -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtConsumo" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtSensores" Grid.Column="1" Style="{StaticResource EtiquetaEstilo}" Margin="16,0,0,0"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
