<!-- Panel "log" tipo terminal: las últimas 8 líneas del Logger en vivo y un cursor "_" morado que parpadea.
     El parpadeo es la ÚNICA animación de la app: saltos discretos (visible/invisible), sin fundidos.
     El marco es el PanelEstilo de Controles.xaml: título "log" en el borde y el comando a la derecha. -->
<UserControl x:Class="OptimizadorPC.Componentes.PanelLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="log" Tag="tail -n 8 log.txt">
        <StackPanel>
            <!-- Las líneas. Cada una: [hora] NIVEL mensaje -->
            <ItemsControl x:Name="ListaLineas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Run = un trozo de texto dentro de la misma línea, cada uno con su color.
                             TextTrimming: las líneas largas se cortan con "…"; al pasar el ratón se ven enteras -->
                        <TextBlock FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoTexto}" Margin="0,1"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Mensaje}">
                            <Run Text="{Binding Hora, Mode=OneWay}" Foreground="{StaticResource TextoSecundarioBrush}"/>
                            <Run Text="{Binding Nivel, Mode=OneWay}" Foreground="{Binding ColorNivel, Mode=OneWay}"/>
                            <Run Text="{Binding Mensaje, Mode=OneWay}" Foreground="{StaticResource TextoBrush}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TxtVacio" Text="sin entradas todavía" FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoTexto}"
                       Foreground="{StaticResource TextoSecundarioBrush}" Visibility="Collapsed"/>

            <!-- Prompt con el cursor que parpadea -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="&gt; " FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoTexto}"
                           Foreground="{StaticResource TextoSecundarioBrush}"/>
                <!-- El parpadeo lo arranca PanelLog.xaml.cs al mostrarse y lo para al ocultarse -->
                <TextBlock x:Name="CursorLog" Text="_" FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoTexto}"
                           FontWeight="Bold" Foreground="{StaticResource AcentoBrush}"/>
            </StackPanel>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
