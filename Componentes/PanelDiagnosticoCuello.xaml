<!-- Diagnóstico de cuello de botella (paso 1 del plan de docs/Investigacion-FiveM.pdf):
     30 s con el juego tal como está, el usuario baja la resolución al mínimo, otros 30 s, y se dice qué limita.
     Va en la pantalla Benchmark y mide el juego elegido en su paso 1 (BenchmarkPagina se lo pasa).
     Los textos con x:Name los pone PanelDiagnosticoCuello.xaml.cs; ningún número es inventado: todos salen de PresentMon -->
<UserControl x:Class="OptimizadorPC.Componentes.PanelDiagnosticoCuello"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="diagnóstico: cpu o gpu" Tag="2 × 30 s">
        <StackPanel>
            <!-- ===== Antes de empezar ===== -->
            <StackPanel x:Name="PanelInicio">
                <TextBlock Style="{StaticResource ExplicacionEstilo}"
                           Text="Antes de optimizar, averigua qué limita tus FPS. Se mide 30 s con el juego tal como está y otros 30 s con la resolución al mínimo. Si los FPS casi no cambian (menos del 10 %), el límite es la CPU o el servidor; si suben, es la GPU."/>
                <Border Style="{StaticResource NotaEstilo}" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource NotaTextoEstilo}"
                               Text="Antes de medir, desactiva VSync y el límite de FPS del juego: si no, los FPS no pueden subir al bajar la resolución y el resultado engaña. Quédate en el mismo sitio durante las dos mediciones."/>
                </Border>
            </StackPanel>

            <!-- ===== Entre las dos mediciones: instrucciones para bajar la resolución ===== -->
            <StackPanel x:Name="PanelResolucion" Visibility="Collapsed">
                <TextBlock x:Name="TxtPrimeraMedicion" Style="{StaticResource DatoEstilo}"/>
                <Border Style="{StaticResource NotaEstilo}" BorderBrush="{StaticResource AvisoBrush}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource NotaTextoEstilo}" FontWeight="SemiBold" Text="Ahora baja la resolución al mínimo:"/>
                        <TextBlock Style="{StaticResource NotaTextoEstilo}" Margin="0,6,0,0"
                                   Text="1. En el juego, abre Ajustes › Gráficos › Resolución y elige la más baja de la lista (por ejemplo 800×600)."/>
                        <TextBlock Style="{StaticResource NotaTextoEstilo}" Margin="0,4,0,0"
                                   Text="2. Deja todo lo demás igual y acepta los cambios."/>
                        <TextBlock Style="{StaticResource NotaTextoEstilo}" Margin="0,4,0,0"
                                   Text="3. Vuelve aquí, pulsa «medir con resolución mínima» y vuelve al juego, al mismo sitio."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Progreso: solo mientras mide ===== -->
            <StackPanel x:Name="PanelProgreso" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="TxtEtapa" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"
                               Foreground="{StaticResource AvisoBrush}"/>
                    <TextBlock x:Name="TxtRestante" HorizontalAlignment="Right" Style="{StaticResource DatoEstilo}"
                               Foreground="{StaticResource TextoSecundarioBrush}"/>
                </Grid>
                <ProgressBar x:Name="BarraProgreso" Style="{StaticResource BarraRecursoEstilo}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- ===== Resultado ===== -->
            <StackPanel x:Name="PanelResultado" Visibility="Collapsed">
                <TextBlock x:Name="TxtCuello" Style="{StaticResource DatoEstilo}" FontSize="{StaticResource TamanoDato}" FontWeight="SemiBold"/>

                <!-- Las dos mediciones, una por línea, como una salida de consola -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="tal como está" Style="{StaticResource EtiquetaEstilo}" VerticalAlignment="Center" Margin="0,3,16,3"/>
                    <TextBlock x:Name="TxtResNormal" Grid.Column="1" Style="{StaticResource DatoEstilo}" Margin="0,3,0,3"/>
                    <TextBlock Grid.Row="1" Text="resolución mínima" Style="{StaticResource EtiquetaEstilo}" VerticalAlignment="Center" Margin="0,3,16,3"/>
                    <TextBlock x:Name="TxtResMinima" Grid.Row="1" Grid.Column="1" Style="{StaticResource DatoEstilo}" Margin="0,3,0,3"/>
                    <TextBlock x:Name="TxtResCambio" Grid.Row="1" Grid.Column="2" Style="{StaticResource DatoEstilo}" FontWeight="SemiBold"
                               Margin="16,3,0,3"/>
                </Grid>

                <TextBlock x:Name="TxtExplicacion" Style="{StaticResource ExplicacionEstilo}" Foreground="{StaticResource TextoBrush}"
                           Margin="0,14,0,0"/>

                <!-- Qué hace Ghost Mode en este caso: "+" sirve, "×" no sirve, "…" pendiente de probar con FiveM instalado -->
                <TextBlock Text="qué hacer:" Style="{StaticResource EtiquetaEstilo}" Margin="0,16,0,6"/>
                <ItemsControl x:Name="ListaRecomendaciones">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Marca}" Style="{StaticResource DatoEstilo}" Foreground="{Binding Color}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource ExplicacionEstilo}"
                                           Foreground="{Binding Color}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource NotaEstilo}" BorderBrush="{StaticResource AvisoBrush}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource NotaTextoEstilo}" Text="Vuelve a poner tu resolución de siempre en el juego."/>
                </Border>
            </StackPanel>

            <!-- ===== Botones ===== -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button x:Name="BtnMedirNormal" Content="[ medir tal como está ]" IsEnabled="False"
                           Style="{StaticResource BotonPrincipalEstilo}" Click="BtnMedirNormal_Click"/>
                <ui:Button x:Name="BtnMedirMinima" Content="[ medir con resolución mínima ]" Visibility="Collapsed"
                           Style="{StaticResource BotonPrincipalEstilo}" Click="BtnMedirMinima_Click"/>
                <ui:Button x:Name="BtnCancelar" Content="[ cancelar ]" Margin="12,0,0,0" Visibility="Collapsed"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnCancelar_Click"/>
                <ui:Button x:Name="BtnEmpezarDeNuevo" Content="[ empezar de nuevo ]" Margin="12,0,0,0" Visibility="Collapsed"
                           Style="{StaticResource BotonSecundarioEstilo}" Click="BtnEmpezarDeNuevo_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtSinJuego" Text="* elige el juego en el paso 1" Style="{StaticResource EtiquetaEstilo}" Margin="0,8,0,0"/>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
