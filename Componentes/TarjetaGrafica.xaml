<!-- Panel del Monitor: título en el borde ("cpu"), valor grande en mono, detalle, gráfica de 60 s y eje de tiempo.
     La línea de la gráfica es gris claro: los datos en vivo no son "Ghost Mode" ni un "OK", así que no llevan color.
     x:Name="Raiz" = nombre del propio control, para enlazar con sus propiedades: {Binding X, ElementName=Raiz}
     (La propiedad Icono sigue existiendo pero no se dibuja: el título ya dice qué es) -->
<UserControl x:Class="OptimizadorPC.Componentes.TarjetaGrafica"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
             x:Name="Raiz">

    <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="{Binding Titulo, ElementName=Raiz}">
        <StackPanel>
            <!-- Fila 1: valor grande a la izquierda, el techo de la gráfica a la derecha -->
            <Grid>
                <!-- Viewbox DownOnly: si el valor no cabe, se encoge en vez de cortarse.
                     En mono, los dígitos miden todos lo mismo: el número no "baila" al cambiar cada segundo -->
                <Viewbox StretchDirection="DownOnly" Height="32" MaxWidth="200" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Valor, ElementName=Raiz}" Style="{StaticResource DatoEstilo}"
                               FontSize="{StaticResource TamanoTitulo}" FontWeight="SemiBold"/>
                </Viewbox>
                <TextBlock Text="{Binding EtiquetaMaximo, ElementName=Raiz}" Style="{StaticResource EtiquetaEstilo}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Fila 2: detalle -->
            <TextBlock Text="{Binding Detalle, ElementName=Raiz}" Style="{StaticResource EtiquetaEstilo}" TextWrapping="Wrap"
                       Margin="0,2,0,10" MinHeight="14"/>

            <componentes:GraficaLinea x:Name="Grafica" Height="90" Maximo="100"
                                      Trazo="{StaticResource TextoBrush}" Lineas="{StaticResource BordeBrush}"/>

            <!-- Eje de tiempo -->
            <Grid Margin="0,6,0,0">
                <TextBlock Text="−60 s" Style="{StaticResource EtiquetaEstilo}"/>
                <TextBlock Text="−30 s" Style="{StaticResource EtiquetaEstilo}" HorizontalAlignment="Center"/>
                <TextBlock Text="ahora" Style="{StaticResource EtiquetaEstilo}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
