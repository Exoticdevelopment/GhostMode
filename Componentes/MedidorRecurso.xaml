<!-- Medidor de un recurso (CPU, RAM, GPU...): etiqueta de consola, valor grande, barra de 2 px y dato secundario.
     x:Name="Raiz" = nombre del propio control, para enlazar con sus propiedades: {Binding X, ElementName=Raiz}
     (La propiedad Icono sigue existiendo pero no se dibuja: la etiqueta "[ CPU ]" ya dice qué es) -->
<UserControl x:Class="OptimizadorPC.Componentes.MedidorRecurso"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">

    <Border Style="{StaticResource TarjetaEstilo}">
        <StackPanel>
            <TextBlock Text="{Binding Etiqueta, ElementName=Raiz}" Style="{StaticResource EtiquetaEstilo}"/>

            <!-- Viewbox con StretchDirection="DownOnly" = si el texto no cabe a lo ancho, lo encoge
                 (nunca lo agranda). Así "6,8 / 16 GB" no se corta en ventanas estrechas -->
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="34" Margin="0,8,0,10">
                <TextBlock Text="{Binding Valor, ElementName=Raiz}" FontFamily="{StaticResource FuenteMono}"
                           FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextoBrush}"/>
            </Viewbox>

            <ProgressBar Style="{StaticResource BarraRecursoEstilo}" Value="{Binding Porcentaje, ElementName=Raiz}"/>

            <!-- Hasta dos líneas (MinHeight = sitio para las dos, así las 4 tarjetas quedan alineadas) -->
            <TextBlock Text="{Binding Detalle, ElementName=Raiz}" Style="{StaticResource EtiquetaEstilo}"
                       Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="30"/>
        </StackPanel>
    </Border>
</UserControl>
