<!-- Medidor de un recurso (CPU, RAM, GPU...): etiqueta + icono, valor grande, barra y dato secundario.
     x:Name="Raiz" = nombre del propio control, para enlazar con sus propiedades: {Binding X, ElementName=Raiz} -->
<UserControl x:Class="OptimizadorPC.Componentes.MedidorRecurso"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Raiz">

    <Border Style="{StaticResource TarjetaEstilo}">
        <StackPanel>
            <Grid>
                <TextBlock Text="{Binding Etiqueta, ElementName=Raiz}" Style="{StaticResource EtiquetaEstilo}"
                           FontSize="13" VerticalAlignment="Center"/>
                <ui:SymbolIcon Symbol="{Binding Icono, ElementName=Raiz}" FontSize="18" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextoSecundarioBrush}"/>
            </Grid>

            <!-- Viewbox con StretchDirection="DownOnly" = si el texto no cabe a lo ancho, lo encoge
                 (nunca lo agranda). Así "No disponible" o "6,8 / 16 GB" no se cortan en ventanas estrechas -->
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="38" Margin="0,8,0,12">
                <TextBlock Text="{Binding Valor, ElementName=Raiz}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoBrush}"/>
            </Viewbox>

            <ProgressBar Style="{StaticResource BarraRecursoEstilo}" Value="{Binding Porcentaje, ElementName=Raiz}"/>

            <!-- Hasta dos líneas (MinHeight = sitio para las dos, así las 4 tarjetas quedan alineadas) -->
            <TextBlock Text="{Binding Detalle, ElementName=Raiz}" FontSize="12" Margin="0,12,0,0"
                       TextWrapping="Wrap" MinHeight="32" Foreground="{StaticResource TextoTenueBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
