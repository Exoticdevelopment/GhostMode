<!-- Paleta "terminal": el NEGRO manda y el morado de la pantera (Assets/ghostmode.ico) es solo un acento.
     Se define UNA vez aquí y se usa en todas partes con {StaticResource NombreBrush}.
     Color = el color "puro"; Brush = la "pintura" que usan fondos y textos.

     Reglas de uso (para que cada color SIGNIFIQUE algo):
       morado = Ghost Mode encendido, lo elegido y la acción principal (y los datos "con Ghost Mode")
       verde  = SOLO un resultado OK (aplicado, conectado, mejoró). Nunca de adorno en iconos o avisos
       ámbar / rojo = aviso / error
       [ corchetes ] = SOLO en botones: si algo va entre corchetes, se puede pulsar -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Superficies -->
    <Color x:Key="FondoColor">#000000</Color>         <!-- fondo de la ventana: negro puro -->
    <Color x:Key="TarjetaColor">#0A0A0A</Color>       <!-- tarjetas, barra lateral, paneles -->
    <!-- Bordes: son la ESTRUCTURA de la interfaz (paneles tipo btop), así que tienen que verse.
         #1A1A1A sobre #0A0A0A daba 1,1:1 y en muchas pantallas desaparecía -->
    <Color x:Key="BordeColor">#262626</Color>         <!-- bordes de 1 px y separadores -->
    <Color x:Key="BordeHoverColor">#3F3F46</Color>    <!-- borde de controles al pasar el ratón -->

    <!-- Acento morado: aparece POCO (botón principal, elemento seleccionado, interruptores activos, cursor del log) -->
    <Color x:Key="AcentoColor">#8B5CF6</Color>
    <Color x:Key="AcentoBrilloColor">#A78BFA</Color>  <!-- hover y estados activos -->
    <Color x:Key="AcentoFondoColor">#2E1065</Color>   <!-- fondo de elementos activos -->

    <!-- Estados -->
    <Color x:Key="ExitoColor">#22C55E</Color>         <!-- verde: SOLO estados "OK" -->
    <Color x:Key="AvisoColor">#F59E0B</Color>         <!-- ámbar: riesgo moderado, "Aplicando" -->
    <Color x:Key="ErrorColor">#EF4444</Color>         <!-- rojo: errores -->

    <!-- Textos -->
    <Color x:Key="TextoColor">#E4E4E7</Color>           <!-- principal: títulos, valores -->
    <!-- Secundario: etiquetas, descripciones. #8A8A94 sobre #0A0A0A = 5,8:1 (el mínimo legible, AA, es 4,5:1;
         el gris anterior #6B6B76 daba 3,8:1 y a 11 px costaba leerlo) -->
    <Color x:Key="TextoSecundarioColor">#8A8A94</Color>

    <SolidColorBrush x:Key="FondoBrush" Color="{StaticResource FondoColor}"/>
    <SolidColorBrush x:Key="TarjetaBrush" Color="{StaticResource TarjetaColor}"/>
    <SolidColorBrush x:Key="BordeBrush" Color="{StaticResource BordeColor}"/>
    <SolidColorBrush x:Key="BordeHoverBrush" Color="{StaticResource BordeHoverColor}"/>
    <SolidColorBrush x:Key="AcentoBrush" Color="{StaticResource AcentoColor}"/>
    <SolidColorBrush x:Key="AcentoBrilloBrush" Color="{StaticResource AcentoBrilloColor}"/>
    <SolidColorBrush x:Key="AcentoFondoBrush" Color="{StaticResource AcentoFondoColor}"/>
    <SolidColorBrush x:Key="ExitoBrush" Color="{StaticResource ExitoColor}"/>
    <SolidColorBrush x:Key="AvisoBrush" Color="{StaticResource AvisoColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="TextoBrush" Color="{StaticResource TextoColor}"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="{StaticResource TextoSecundarioColor}"/>

    <!-- Nombres de la paleta anterior, para que las pantallas aún no rediseñadas sigan funcionando:
         "Activo" = estado OK (verde) y "TextoTenue" = el gris secundario -->
    <SolidColorBrush x:Key="ActivoBrush" Color="{StaticResource ExitoColor}"/>
    <SolidColorBrush x:Key="TextoTenueBrush" Color="{StaticResource TextoSecundarioColor}"/>

    <!-- Versiones translúcidas para fondos de pastillas y avisos.
         Los dos primeros dígitos son la opacidad: 26 ≈ 15 % -->
    <SolidColorBrush x:Key="ActivoSuaveBrush" Color="#2622C55E"/>
    <SolidColorBrush x:Key="AvisoSuaveBrush" Color="#26F59E0B"/>
    <SolidColorBrush x:Key="ErrorSuaveBrush" Color="#26EF4444"/>

    <!-- ===== Recursos de WPF-UI que reemplazamos =====
         Funciona porque este archivo se carga DESPUÉS del tema de WPF-UI (el último gana). -->

    <!-- Fondo de la ventana -->
    <Color x:Key="ApplicationBackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#000000"/>

    <!-- Esquinas: 2 px como máximo en botones, cuadros de texto, diálogos... -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>

    <!-- Barra lateral (NavigationView): elemento seleccionado con fondo morado oscuro e indicador morado -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#000000"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#111111"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource AcentoFondoColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="{StaticResource AcentoFondoColor}"/>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource AcentoColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource TextoSecundarioColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="{StaticResource TextoSecundarioColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource TextoColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="{StaticResource TextoColor}"/>
</ResourceDictionary>
