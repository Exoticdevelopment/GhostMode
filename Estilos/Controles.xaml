<!-- Estilos compartidos por todas las pantallas. Estética "terminal": negro, bordes de 1 px,
     esquinas de 2 px como máximo, sin sombras ni degradados (única excepción: el brillo del botón de Ghost Mode en Inicio), letra monoespaciada para datos.
     Un Style = un "molde" de propiedades. Se usa con Style="{StaticResource NombreEstilo}".
     Si un estilo no tiene x:Key, se aplica SOLO a todos los controles de ese tipo (estilo implícito). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:componentes="clr-namespace:OptimizadorPC.Componentes"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Traemos la paleta aquí también para que los estilos encuentren los colores -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colores.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Tipografía =====
         Cascadia Mono viene con Windows 11. Si no está, WPF prueba la siguiente de la lista: Consolas -->
    <FontFamily x:Key="FuenteMono">Cascadia Mono, Consolas</FontFamily>
    <!-- Solo para textos largos de explicación -->
    <FontFamily x:Key="FuenteTexto">Segoe UI</FontFamily>

    <!-- Escala de tamaños: SOLO estos cinco. Cada salto es claro (≈ ×1,25 a ×1,5), así la jerarquía
         se ve sin necesidad de negritas ni colores. sys:Double = un número decimal guardado como recurso.
         Uso: FontSize="{StaticResource TamanoDato}" -->
    <sys:Double x:Key="TamanoEtiqueta">11</sys:Double>   <!-- etiquetas, títulos de panel, notas -->
    <sys:Double x:Key="TamanoTexto">13</sys:Double>      <!-- texto normal, datos de tabla, botones -->
    <sys:Double x:Key="TamanoDato">16</sys:Double>       <!-- nombres de ajustes, valores destacados -->
    <sys:Double x:Key="TamanoTitulo">24</sys:Double>     <!-- título de página, valores de los medidores -->
    <sys:Double x:Key="TamanoHeroe">36</sys:Double>      <!-- el número más importante de una pantalla -->

    <!-- ===== Textos ===== -->

    <!-- Título tipo comando de la bienvenida: "> hola". Las páginas usan Componentes/PromptTerminal -->
    <Style x:Key="TituloPaginaEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize" Value="{StaticResource TamanoTitulo}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
    </Style>

    <!-- Explicación corta debajo del título (texto largo → Segoe UI) -->
    <Style x:Key="SubtituloPaginaEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
    </Style>

    <!-- Etiquetas de consola en mayúsculas: "[ CPU ]", "SYS.STATUS"... -->
    <Style x:Key="EtiquetaEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
    </Style>

    <!-- Datos y números: "24 %", "4,6 / 16 GB" -->
    <Style x:Key="DatoEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
    </Style>

    <!-- Explicación larga dentro de una tarjeta (Segoe UI) -->
    <Style x:Key="ExplicacionEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
    </Style>

    <!-- ===== Tarjeta: superficie #0A0A0A, borde de 1 px, esquinas de 2 px =====
         Sin efecto al pasar el ratón: una tarjeta no se puede pulsar, y si reacciona parece que sí -->

    <Style x:Key="TarjetaEstilo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TarjetaBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- ===== Panel: el marco "de terminal" de toda la app =====
         Como en btop/htop: un borde de 1 px sobre negro con el título INCRUSTADO en la línea de arriba,
         y opcionalmente un dato a la derecha (Tag):   ┌─ cpu ────────── 12 hilos ─┐
         HeaderedContentControl = un control con dos huecos: Header (el título) y Content (lo de dentro).
         Uso:  <HeaderedContentControl Style="{StaticResource PanelEstilo}" Header="cpu" Tag="12 hilos"> ... </HeaderedContentControl>
         El fondo del título es el mismo que el del panel (negro): así "corta" la línea del borde. -->

    <Style x:Key="PanelEstilo" TargetType="HeaderedContentControl">
        <Setter Property="Background" Value="{StaticResource FondoBrush}"/>
        <!-- Dynamic: gris con Ghost Mode apagado, morado encendido (Servicios/TemaGhost.cs) -->
        <Setter Property="BorderBrush" Value="{DynamicResource MarcoBrush}"/>
        <Setter Property="Padding" Value="16,18,16,14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <!-- El marco empieza 7 px más abajo: la mitad de la altura del título, para que la línea lo cruce por el medio -->
                        <Border Margin="0,7,0,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <!-- Título a la izquierda. Binding (y no TemplateBinding) porque Header es un "object"
                             y Text espera texto: Binding sí sabe convertirlo -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Padding="6,0"
                                Background="{TemplateBinding Background}">
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoEtiqueta}"
                                       Foreground="{StaticResource TextoBrush}"/>
                        </Border>

                        <!-- Dato a la derecha (Tag). Si no hay Tag, no se dibuja -->
                        <Border x:Name="CajaDato" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,10,0" Padding="6,0"
                                Background="{TemplateBinding Background}">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource FuenteMono}" FontSize="{StaticResource TamanoEtiqueta}"
                                       Foreground="{StaticResource TextoSecundarioBrush}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="CajaDato" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Casilla de consola: "[ ] nombre" / "[x] nombre" =====
         Reemplaza la casilla redondeada de WPF-UI. Lleva corchetes porque se puede pulsar -->

    <Style x:Key="CasillaEstilo" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize" Value="{StaticResource TamanoTexto}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fondo transparente: toda la zona recibe el clic, no solo las letras -->
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="Marca" Text="[ ]" Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <ContentPresenter x:Name="Texto" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Sin texto (Content vacío): sin hueco a la derecha de la marca -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Texto" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marca" Property="Foreground" Value="{StaticResource TextoBrush}"/>
                        </Trigger>
                        <!-- Marcada: "[x]" en morado claro (morado sobre negro: se lee bien) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Marca" Property="Text" Value="[x]"/>
                            <Setter TargetName="Marca" Property="Foreground" Value="{StaticResource AcentoBrilloBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Marca" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nota / aviso: una barra de 2 px a la izquierda y el texto, sin caja de color =====
         Gris = información; para un aviso se cambia el borde: BorderBrush="{StaticResource AvisoBrush}".
         Así el color solo aparece donde hay algo que vigilar -->

    <Style x:Key="NotaEstilo" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BordeHoverBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="12,2,0,2"/>
    </Style>

    <!-- El texto de dentro de una nota (Segoe, se lee mejor en frases largas) -->
    <Style x:Key="NotaTextoEstilo" TargetType="TextBlock" BasedOn="{StaticResource ExplicacionEstilo}">
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
    </Style>

    <!-- ===== Dato de una fila: "impacto alto", "riesgo seguro"... texto mono pequeño, sin caja ===== -->

    <Style x:Key="MetaEstilo" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaEstilo}">
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Pastilla: "ALTO", "SEGURO"... Solo borde, sin relleno ===== -->

    <Style x:Key="PastillaEstilo" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeHoverBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="PastillaTextoEstilo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
    </Style>

    <!-- ===== Botones: letra monoespaciada, esquinas de 2 px ===== -->
    <!-- BasedOn = "parte del estilo de botón de WPF-UI y cambia solo esto" -->

    <!-- Principal: relleno morado con texto NEGRO (regla de contraste: sobre morado, texto negro o blanco;
         texto morado solo sobre negro). Los colores van puestos a mano en vez de Appearance="Primary":
         ese modo calcula sus propios tonos del acento y no asegura el texto negro -->
    <Style x:Key="BotonPrincipalEstilo" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource FondoBrush}"/>
        <Setter Property="MouseOverBackground" Value="{StaticResource AcentoBrilloBrush}"/>
        <Setter Property="MouseOverBorderBrush" Value="{StaticResource AcentoBrilloBrush}"/>
        <Setter Property="PressedBackground" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="PressedBorderBrush" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="PressedForeground" Value="{StaticResource FondoBrush}"/>
    </Style>

    <!-- Secundario: negro con borde gris; al pasar el ratón, borde y texto más claros -->
    <Style x:Key="BotonSecundarioEstilo" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource TarjetaBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeHoverBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        <Setter Property="MouseOverBackground" Value="{StaticResource BordeBrush}"/>
        <Setter Property="MouseOverBorderBrush" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="PressedBackground" Value="{StaticResource BordeHoverBrush}"/>
    </Style>

    <!-- ===== Enlace: texto mono gris que se pone morado al pasar el ratón =====
         Es un Button (se puede usar con Tab y Enter) dibujado como texto. La URL va en Tag
         y el Click la abre con Servicios/Enlaces.cs -->

    <Style x:Key="EnlaceEstilo" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource FuenteMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Fondo transparente: así toda la línea recibe el ratón, no solo las letras -->
                    <Border Background="Transparent">
                        <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource AcentoBrilloBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Texto" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barra de recurso: 2 px, pista gris oscura, relleno claro ===== -->

    <Style x:Key="BarraRecursoEstilo" TargetType="ProgressBar">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- ControlTemplate = cómo se DIBUJA el control.
                     PART_Track y PART_Indicator son nombres que ProgressBar busca:
                     él mismo ajusta el ancho del indicador según Value. -->
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{StaticResource BordeBrush}"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Interruptor de cuatro estados (Componentes/InterruptorEstado.cs) ===== -->
    <!-- Sin x:Key: se aplica a TODOS los InterruptorEstado.
         Rectangular, como un interruptor de consola. Los Trigger cambian el dibujo según
         IsChecked (activo/inactivo) y Estado (aplicando/error). Sin animaciones. -->

    <Style TargetType="componentes:InterruptorEstado">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="componentes:InterruptorEstado">
                    <!-- El fondo. Por defecto = Inactivo: negro con borde gris y el cuadradito a la izquierda -->
                    <Border x:Name="Fondo" CornerRadius="2" BorderThickness="1"
                            Background="{StaticResource FondoBrush}"
                            BorderBrush="{StaticResource BordeHoverBrush}">
                        <Grid Margin="3,0">
                            <!-- El cuadradito que se mueve -->
                            <Rectangle x:Name="Bolita" Width="14" Height="14" HorizontalAlignment="Left"
                                       Fill="{StaticResource TextoSecundarioBrush}"/>

                            <!-- "Aplicando": tres puntos ámbar fijos (sin animación: PCs de pocos recursos) -->
                            <TextBlock x:Name="Puntos" Text="..." FontFamily="{StaticResource FuenteMono}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"
                                       Foreground="{StaticResource AvisoBrush}" Visibility="Collapsed"/>

                            <!-- La X de "Error" -->
                            <Path x:Name="Cruz" Width="8" Height="8" HorizontalAlignment="Center"
                                  Visibility="Collapsed" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                  Data="M 0,0 L 8,8 M 8,0 L 0,8"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Activo: relleno morado, cuadradito negro a la derecha -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoBrush}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                            <Setter TargetName="Bolita" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Bolita" Property="Fill" Value="{StaticResource FondoBrush}"/>
                        </Trigger>

                        <!-- Al pasar el ratón: borde más claro (morado brillante si está activo) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource TextoSecundarioBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoBrilloBrush}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AcentoBrilloBrush}"/>
                        </MultiTrigger>

                        <!-- Aplicando: negro, borde ámbar, "..." en el centro.
                             Va DESPUÉS de IsChecked para ganarle (en los Trigger, el último gana) -->
                        <Trigger Property="Estado" Value="Aplicando">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource FondoBrush}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AvisoBrush}"/>
                            <Setter TargetName="Bolita" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Puntos" Property="Visibility" Value="Visible"/>
                            <Setter Property="Cursor" Value="Wait"/>
                        </Trigger>

                        <!-- Error: fondo rojo translúcido, borde rojo y una X -->
                        <Trigger Property="Estado" Value="Error">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ErrorSuaveBrush}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                            <Setter TargetName="Bolita" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Cruz" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Foco con teclado (Tab): borde claro para saber dónde estamos -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource TextoBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
