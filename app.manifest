<?xml version="1.0" encoding="utf-8"?>
<!-- Este archivo se incrusta dentro del .exe. Windows lo lee ANTES de abrir la app. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="OptimizadorPC.app"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- requireAdministrator = Windows muestra el aviso de UAC al abrir la app.
             Sin esto no podríamos usar powercfg, crear puntos de restauración
             ni escribir en C:\ProgramData. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Le decimos a Windows que la app está pensada para Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
